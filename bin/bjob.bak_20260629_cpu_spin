#!/bin/bash
# bjob — Interactive SLURM job manager for Berzelius (NSC/LiU)

# ══════════════════════════════════════════════════════════════════════════════
# DEFAULT VALUES — starting point when creating a new profile (edit freely)
# ══════════════════════════════════════════════════════════════════════════════
D_ACCOUNT=""          # e.g. "berzelius-2024-1"  (blank = auto-detect)
D_PARTITION="berzelius"
D_GPUS="1"
D_TIME="06:00:00"
D_MEM="32G"
# ══════════════════════════════════════════════════════════════════════════════

set -euo pipefail

# ── Colors ────────────────────────────────────────────────────────────────────
R='\033[0;31m' G='\033[0;32m' Y='\033[1;33m'
B='\033[0;34m' C='\033[0;36m' BOLD='\033[1m' DIM='\033[2m' NC='\033[0m'

# ── Paths ─────────────────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
TOOLBOX_DIR="$(dirname "$SCRIPT_DIR")"
JOBS_DIR="$TOOLBOX_DIR/jobs"
PROJECT="${PROJECT:-/proj/rpl-soro/users/$USER}"

mkdir -p "$JOBS_DIR"
leave_alt_screen() {
    tput cnorm 2>/dev/null || true
    if [[ "${BJOB_ALT_SCREEN:-0}" == "1" ]]; then
        printf '\033[H\033[2J\033[?1049l' 2>/dev/null || true
        BJOB_ALT_SCREEN=0
    fi
}
cleanup() {
    leave_alt_screen
    stty sane 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# ── Basic helpers ─────────────────────────────────────────────────────────────
header() {
    printf "${BOLD}${B}\n"
    printf "  ╔══════════════════════════════════════════╗\n"
    printf "  ║      Berzelius Job Manager  (bjob)       ║\n"
    printf "  ╚══════════════════════════════════════════╝\n"
    printf "${NC}\n"
}

get_jobs() {
    squeue -u "$USER" -h --format="%i|%T|%j|%P|%L|%R" 2>/dev/null || true
}

detect_accounts() {
    sacctmgr show associations user="$USER" format=account%40 -n -P 2>/dev/null \
        | cut -d'|' -f1 | sort -u | tr '\n' ' ' | xargs
}

prompt() {
    local label="$1" default="$2" varname="$3"
    local input
    read -rp "  $label [$default]: " input
    printf -v "$varname" '%s' "${input:-$default}"
}

term_cols() {
    local cols
    cols=$(tput cols 2>/dev/null || printf '80')
    [[ "$cols" =~ ^[0-9]+$ ]] || cols=80
    (( cols < 40 )) && cols=40
    printf '%s' "$cols"
}

trunc_pad() {
    local value="$1" width="$2"
    if (( width <= 0 )); then
        return 0
    fi
    if (( ${#value} > width )); then
        if (( width <= 1 )); then
            printf '%.*s' "$width" "$value"
        else
            printf '%s…' "${value:0:width-1}"
        fi
    else
        printf '%-*s' "$width" "$value"
    fi
}

rule_line() {
    local cols="$1" prefix="${2:-  }" width
    width=$(( cols - ${#prefix} - 1 ))
    (( width < 8 )) && width=8
    printf '%s' "$prefix"
    printf '%*s' "$width" '' | tr ' ' '-'
    printf '\n'
}

job_name_for_id() {
    local jobid="$1"
    squeue -j "$jobid" -h --format="%j" 2>/dev/null | awk 'NR==1 {print $1}'
}

usage() {
    cat <<EOF
Usage:
  bjob                         Open the interactive job manager
  bjob connect <jobid> [role]  Connect to a running allocation
  bjob cmds <jobid>            Print IDE-terminal commands for a job
  bjob gpu <jobid>             Show GPU power/utilization for a job
  bjob logs <jobid>            Print tmux/log file paths for a job

Roles for daaam-cosmos:
  cosmos    Start Cosmos-Reason2 server
  daaam     Open prepared DAAAM shell for ROS launch or bag play
  shell     Open a plain shell in the allocation
  gpu       Show GPU power/utilization
  logs      Print tmux/log file paths
  auto-launch  Run selected batch range ROS launch worker
  auto-bag     Run selected batch range rosbag worker
  auto      Run Cosmos, ROS launch, and delayed rosbag workers together
EOF
}

select_daaam_cosmos_role() {
    local choice
    printf "\n${BOLD}${Y}  Select daaam-cosmos terminal${NC}\n\n" >&2
    printf "  1) cosmos  Start Cosmos-Reason2 server\n" >&2
    printf "  2) daaam   Prepared DAAAM shell for ROS launch or bag play\n" >&2
    printf "  3) shell   Plain shell in allocation\n" >&2
    printf "  4) gpu          Show GPU power/utilization\n" >&2
    printf "  5) logs         Print tmux/log file paths\n" >&2
    printf "  6) auto-launch  Run selected batch range ROS launch worker\n" >&2
    printf "  7) auto-bag     Run selected batch range rosbag worker\n" >&2
    printf "  8) auto         Run Cosmos + launch + bag workers together\n" >&2
    printf "  q) cancel\n\n" >&2
    read -rp "  Choice [shell]: " choice
    case "${choice:-3}" in
        1|cosmos|server) printf "cosmos" ;;
        2|daaam|ros|launch|bag|play) printf "daaam" ;;
        3|shell|sh|"")   printf "shell" ;;
        4|gpu)           printf "gpu" ;;
        5|log|logs)      printf "logs" ;;
        6|auto-launch|launch-auto|batch-launch|launch-batches) printf "auto-launch" ;;
        7|auto-bag|bag-auto|batch-bag|play-batches)             printf "auto-bag" ;;
        8|auto|auto-all|batch-auto|all)                            printf "auto" ;;
        q|Q|quit|cancel) return 1 ;;
        *)
            printf "${R}  Unknown choice: %s${NC}\n" "$choice" >&2
            return 1 ;;
    esac
}


_AUTO_BATCH_START=""
_AUTO_BATCH_END=""

prompt_afk_launch_mode() {
    printf "\n${BOLD}${Y}  daaam-cosmos launch mode${NC}\n\n" >&2
    printf "  1) interactive   srun — one shared allocation (cosmos + DAAAM share one GPU)\n" >&2
    printf "  2) afk           sbatch — separate cosmos (4 h) and DAAAM (59:59) allocations,\n" >&2
    printf "                   DAAAM resubmits automatically until all batches finish\n" >&2
    printf "  q) cancel\n\n" >&2
    local choice
    read -rp "  Choice [1]: " choice
    case "${choice:-1}" in
        1|i|interactive) printf "interactive" ;;
        2|s|smart|afk) printf "afk" ;;
        q|Q) return 1 ;;
        *) printf "interactive" ;;
    esac
}

launch_afk() {
    local name="$1"
    load_profile "$name"

    if [[ -z "${D_ACCOUNT:-}" ]]; then
        local detected; detected=$(detect_accounts)
        D_ACCOUNT=$(awk '{print $1}' <<< "$detected")
    fi
    if [[ -z "${D_ACCOUNT:-}" ]]; then
        printf "\n${R}  Could not detect a SLURM account for user '%s'.${NC}\n" "$USER"
        printf "\n  ${DIM}Press any key to return...${NC}"
        IFS= read -rsn1 2>/dev/null || true
        return 1
    fi

    prompt_auto_batch_range || return 1

    # Session ID keyed by launch time — shared by cosmos and DAAAM jobs
    local session_id state_dir
    session_id="$(date +%Y%m%d_%H%M%S)"
    state_dir="$PROJECT/.cache/daaam-cosmos-auto/$session_id"

    # Cosmos: 4 h, lighter memory (same partition/account as DAAAM)
    local cosmos_mem="40G"
    local cosmos_cfg="$JOBS_DIR/cosmos-reason2/config.sh"
    [[ -f "$cosmos_cfg" ]] && cosmos_mem=$(bash -c "source \"$cosmos_cfg\" 2>/dev/null; printf '%s' \"\${D_MEM:-40G}\"")

    # DAAAM: 59:59, daaam-cosmos mem
    local daaam_mem="${D_MEM:-80G}"
    local daaam_gpus="${D_GPUS:-1}"

    printf "\n${BOLD}${Y}  afk launch — %s${NC}\n" "$session_id"
    printf "  State dir:  %s\n" "$state_dir"
    printf "  Batches:    batch_%s..batch_%s\n" "$_AUTO_BATCH_START" "$_AUTO_BATCH_END"
    printf "  Cosmos:     4 h · %s GPU · %s · %s\n" "$daaam_gpus" "$cosmos_mem" "$D_PARTITION"
    printf "  DAAAM:      59:59 · %s GPU · %s · %s (auto-resubmit)\n" "$daaam_gpus" "$daaam_mem" "$D_PARTITION"
    printf "\n"
    local confirm
    read -rp "  Submit both jobs? [Y/n]: " confirm
    [[ "${confirm:-Y}" =~ ^[Nn]$ ]] && return 1

    local cosmos_script="$JOBS_DIR/$name/sbatch_cosmos.sh"
    local daaam_script="$JOBS_DIR/$name/sbatch_daaam.sh"
    for f in "$cosmos_script" "$daaam_script"; do
        if [[ ! -f "$f" ]]; then
            printf "${R}  Missing: %s${NC}\n" "$f"
            printf "\n  ${DIM}Press any key to return...${NC}"
            IFS= read -rsn1 2>/dev/null || true
            return 1
        fi
    done

    mkdir -p "$state_dir/logs"

    local profile_dir="$JOBS_DIR/$name"

    # Submit cosmos server (4 h)
    local cosmos_out
    if ! cosmos_out=$(sbatch \
            --account="$D_ACCOUNT" \
            --partition="$D_PARTITION" \
            --gpus="$daaam_gpus" \
            --time=04:00:00 \
            --mem="$cosmos_mem" \
            --job-name=cosmos-server \
            --output="$state_dir/logs/cosmos_slurm-%j.log" \
            --export=ALL,DAAAM_PROFILE_DIR="$profile_dir",DAAAM_AUTO_STATE_DIR="$state_dir" \
            "$cosmos_script" 2>&1); then
        printf "${R}  Failed to submit cosmos job:\n  %s${NC}\n" "$cosmos_out"
        printf "\n  ${DIM}Press any key to return...${NC}"
        IFS= read -rsn1 2>/dev/null || true
        return 1
    fi
    local cosmos_jobid
    cosmos_jobid=$(awk '{print $NF}' <<< "$cosmos_out")
    printf "${G}  Cosmos server submitted: job %s${NC}\n" "$cosmos_jobid"

    # Submit DAAAM worker (59:59, starts after cosmos job begins)
    local daaam_out
    if ! daaam_out=$(sbatch \
            --account="$D_ACCOUNT" \
            --partition="$D_PARTITION" \
            --gpus="$daaam_gpus" \
            --time=00:59:59 \
            --mem="$daaam_mem" \
            --job-name=daaam-worker \
            --output="$state_dir/logs/daaam_slurm-%j.log" \
            --dependency="after:$cosmos_jobid" \
            --export=ALL,DAAAM_PROFILE_DIR="$profile_dir",DAAAM_AUTO_STATE_DIR="$state_dir",DAAAM_AUTO_BATCH_START="$_AUTO_BATCH_START",DAAAM_AUTO_BATCH_END="$_AUTO_BATCH_END",DAAAM_SBATCH_MEM="$daaam_mem",DAAAM_SBATCH_GPUS="$daaam_gpus",COSMOS_JOB_ID="$cosmos_jobid" \
            "$daaam_script" 2>&1); then
        printf "${R}  Failed to submit DAAAM job:\n  %s${NC}\n" "$daaam_out"
        printf "\n  ${DIM}Press any key to return...${NC}"
        IFS= read -rsn1 2>/dev/null || true
        return 1
    fi
    local daaam_jobid
    daaam_jobid=$(awk '{print $NF}' <<< "$daaam_out")
    printf "${G}  DAAAM worker submitted:  job %s (starts after cosmos begins)${NC}\n" "$daaam_jobid"

    printf "\n${C}  Monitor:${NC}\n"
    printf "    squeue -u %s\n" "$USER"
    printf "    tail -f %s/logs/auto_launch.log\n" "$state_dir"
    printf "    tail -f %s/logs/cosmos-reason2-vllm.log\n" "$state_dir"
    printf "\n  ${DIM}Press any key to return...${NC}"
    IFS= read -rsn1 2>/dev/null || true
}

prompt_auto_batch_range() {
    local default_start="${DAAAM_AUTO_BATCH_START:-1}"
    local default_end="${DAAAM_AUTO_BATCH_END:-7}"
    local input cleaned start end

    printf "\n${BOLD}${Y}  Automated batch range${NC}\n" >&2
    printf "  Examples: 1-7, 3-5, 6, batch_4-batch_7\n" >&2
    read -rp "  Batch range [${default_start}-${default_end}]: " input

    if [[ -z "$input" ]]; then
        start="$default_start"
        end="$default_end"
    elif [[ "$input" =~ ^[[:space:]]*(batch_?)?([0-9]+)[[:space:]]+[[:space:]]*(batch_?)?([0-9]+)[[:space:]]*$ ]]; then
        start="${BASH_REMATCH[2]}"
        end="${BASH_REMATCH[4]}"
    else
        cleaned="${input,,}"
        cleaned="${cleaned//batch_/}"
        cleaned="${cleaned//batch/}"
        cleaned="${cleaned//[[:space:]]/}"
        cleaned="${cleaned//,/-}"
        cleaned="${cleaned//--/-}"
        if [[ "$cleaned" =~ ^([0-9]+)-([0-9]+)$ ]]; then
            start="${BASH_REMATCH[1]}"
            end="${BASH_REMATCH[2]}"
        elif [[ "$cleaned" =~ ^([0-9]+)$ ]]; then
            start="${BASH_REMATCH[1]}"
            end="$start"
        else
            printf "${R}  Could not parse batch range: %s${NC}\n" "$input" >&2
            return 1
        fi
    fi

    if ! [[ "$start" =~ ^[0-9]+$ && "$end" =~ ^[0-9]+$ ]]; then
        printf "${R}  Batch range must be numeric.${NC}\n" >&2
        return 1
    fi
    if (( start < 1 || end < 1 || start > end )); then
        printf "${R}  Invalid batch range: %s-%s${NC}\n" "$start" "$end" >&2
        return 1
    fi

    _AUTO_BATCH_START="$start"
    _AUTO_BATCH_END="$end"
    printf "${C}  Using batch_%s..batch_%s${NC}\n" "$start" "$end" >&2
}

# ── Profile storage ───────────────────────────────────────────────────────────
list_profiles() {
    find "$JOBS_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort
}

load_profile() {
    local cfg="$JOBS_DIR/$1/config.sh"
    [[ -f "$cfg" ]] && source "$cfg" || true
}

save_profile() {
    local name="$1"
    mkdir -p "$JOBS_DIR/$name"
    cat > "$JOBS_DIR/$name/config.sh" <<EOF
D_ACCOUNT="$D_ACCOUNT"
D_PARTITION="$D_PARTITION"
D_GPUS="${D_GPUS:-1}"
D_TIME="$D_TIME"
D_MEM="$D_MEM"
D_JOBNAME="$name"
EOF
}

# Plain-text one-liner summary for a profile (subshell — no side effects)
profile_line() {
    local name="$1" width="${2:-72}"
    (
        source "$JOBS_DIR/$name/config.sh" 2>/dev/null || true
        local gpu=""
        [[ "${D_PARTITION:-}" != "cpu" && "${D_PARTITION:-}" != "berzelius-cpu" ]] && gpu="${D_GPUS:-1}G"
        local setup=""
        [[ -f "$JOBS_DIR/$name/setup.sh" ]] && setup=" setup"
        local line
        if (( width < 58 )); then
            line="${name} ${D_PARTITION:-?} ${gpu} ${D_TIME:-?} ${D_MEM:-?}${setup}"
        else
            line=$(printf "%-14s %-12s %-3s %-9s %-6s %s%s"                 "$name" "${D_PARTITION:-?}" "$gpu" "${D_TIME:-?}" "${D_MEM:-?}"                 "${D_ACCOUNT:-?}" "$setup")
        fi
        trunc_pad "$line" "$width"
    )
}

# ── Shared result variable ────────────────────────────────────────────────────
_RESULT=""

# ── Global render state — main screen ────────────────────────────────────────
_SEL=0
_NJOBS=0
declare -a _JIDS=() _JSTATES=() _JNAMES=() _JPARTS=() _JTIMES=() _JREASONS=()

# ── Global render state — profile selector ────────────────────────────────────
_SP_SEL=0
_SP_N=0
declare -a _SP_PROFILES=() _SP_DISP=()

_draw() {
    local cols content_w i prefix state line hint
    cols=$(term_cols)
    content_w=$(( cols - 6 ))
    (( content_w < 20 )) && content_w=20

    for ((i = 0; i < _NJOBS; i++)); do
        if [[ $i -eq $_SEL ]]; then
            prefix="  ${G}❯${NC} ${BOLD}"
        else
            prefix="    ${DIM}"
        fi

        case "${_JSTATES[$i]}" in
            RUNNING) state="R" ;;
            PENDING) state="P" ;;
            *) state="${_JSTATES[$i]:0:1}" ;;
        esac

        if (( cols < 70 )); then
            line=$(printf '%s %s %s %s' \
                "${_JIDS[$i]}" "$state" "${_JNAMES[$i]}" "${_JTIMES[$i]}")
        else
            line=$(printf '%s %s %s %s %s' \
                "${_JIDS[$i]}" "$state" "${_JNAMES[$i]}" "${_JTIMES[$i]}" "${_JREASONS[$i]}")
        fi
        printf "%b%s${NC}\n" "$prefix" "$(trunc_pad "$line" "$content_w")"
    done

    printf "${DIM}"
    rule_line "$cols" "  "
    printf "${NC}"
    if [[ $_SEL -eq $_NJOBS ]]; then
        printf "  ${G}❯${NC} ${BOLD}${G}+ New job${NC}\n"
    else
        printf "    ${DIM}+ New job${NC}\n"
    fi
    printf "\n"

    if [[ $_SEL -lt $_NJOBS ]]; then
        if [[ "${_JSTATES[$_SEL]}" == "RUNNING" ]]; then
            if (( cols < 72 )); then
                hint='[c] conn [l] logs [g] gpu [k] kill [r] ref [q] quit'
            else
                hint='[c] connect  [p] cmds  [l] logs  [g] gpu  [k] cancel  up/down  [r] refresh  [q] quit'
            fi
        else
            if (( cols < 72 )); then
                hint='[k] kill  up/down  [r] ref  [q] quit'
            else
                hint='[k] cancel  up/down navigate  [r] refresh  [q] quit'
            fi
        fi
    else
        if (( cols < 72 )); then
            hint='[Enter] new  up/down  [r] ref  [q] quit'
        else
            hint='[Enter] new job  up/down navigate  [r] refresh  [q] quit'
        fi
    fi
    printf "  ${DIM}%s${NC}\n" "$(trunc_pad "$hint" "$content_w")"
}

# ── Profile selector draw (top-level — reads _SP_* globals) ──────────────────
_sp_draw() {
    local i cols item_w hint_w hint
    cols=$(term_cols)
    item_w=$(( cols - 8 ))
    (( item_w < 24 )) && item_w=24
    hint_w=$(( cols - 4 ))
    (( hint_w < 20 )) && hint_w=20

    for ((i = 0; i < _SP_N; i++)); do
        if [[ $i -eq $_SP_SEL ]]; then
            printf "  ${BOLD}${G} ❯  ${NC}${BOLD}%s${NC}\n" "$(trunc_pad "${_SP_DISP[$i]}" "$item_w")"
        else
            printf "      ${DIM}%s${NC}\n" "$(trunc_pad "${_SP_DISP[$i]}" "$item_w")"
        fi
    done

    printf "${DIM}"
    rule_line "$cols" "      "
    printf "${NC}"
    if [[ $_SP_SEL -eq $_SP_N ]]; then
        printf "  ${BOLD}${G} ❯  ${NC}${BOLD}${G}+ Create profile${NC}\n"
    else
        printf "      ${DIM}+ Create profile${NC}\n"
    fi
    printf "\n"

    if [[ $_SP_SEL -lt $_SP_N ]]; then
        if (( cols < 72 )); then
            hint='up/down enter launch e edit d del q back'
        else
            hint='up/down navigate  [Enter] launch  [d] delete  [e] edit setup.sh  [q] back'
        fi
    else
        if (( cols < 72 )); then
            hint='up/down enter create q back'
        else
            hint='up/down navigate  [Enter] create  [q] back'
        fi
    fi
    printf "  ${DIM}%s${NC}\n" "$(trunc_pad "$hint" "$hint_w")"
}

# ── Arrow-key profile selector ────────────────────────────────────────────────
# Sets _RESULT; returns 0 on selection, 1 on back/quit.
select_profile() {
    _RESULT=""
    _SP_PROFILES=()
    mapfile -t _SP_PROFILES < <(list_profiles)
    _SP_N=${#_SP_PROFILES[@]}

    _SP_DISP=()
    local p cols item_w
    cols=$(term_cols)
    item_w=$(( cols - 8 ))
    (( item_w < 24 )) && item_w=24
    for p in "${_SP_PROFILES[@]}"; do
        _SP_DISP+=("$(profile_line "$p" "$item_w")")
    done
    _SP_SEL=0

    local nrows=$((_SP_N + 1))   # profiles + "new profile" row
    local redrawn=$((_SP_N + 4)) # profiles + divider + new_row + blank + hint

    printf "\n${BOLD}${Y}  ── Job Profiles ──${NC}\n\n"
    _sp_draw
    tput civis 2>/dev/null

    while true; do
        tput cuu $redrawn
        local key="" seq=""
        IFS= read -rsn1 key 2>/dev/null || true

        case "$key" in
            $'\x1b')
                IFS= read -rsn2 -t 0.1 seq 2>/dev/null || true
                case "$seq" in
                    '[A') (( _SP_SEL > 0        )) && (( _SP_SEL-- )) || true ;;
                    '[B') (( _SP_SEL < nrows-1  )) && (( _SP_SEL++ )) || true ;;
                esac ;;
            '')  # Enter
                tput cud $redrawn; tput cnorm 2>/dev/null
                if [[ $_SP_SEL -eq $_SP_N ]]; then
                    _RESULT="__new__"
                else
                    _RESULT="${_SP_PROFILES[$_SP_SEL]}"
                fi
                return 0 ;;
            d|D)
                if [[ $_SP_SEL -lt $_SP_N ]]; then
                    tput cud $redrawn; tput cnorm 2>/dev/null
                    _RESULT="__delete__:${_SP_PROFILES[$_SP_SEL]}"; return 0
                fi ;;
            e|E)
                if [[ $_SP_SEL -lt $_SP_N ]]; then
                    tput cud $redrawn; tput cnorm 2>/dev/null
                    _RESULT="__edit__:${_SP_PROFILES[$_SP_SEL]}"; return 0
                fi ;;
            q|Q)
                tput cud $redrawn; tput cnorm 2>/dev/null
                return 1 ;;
        esac
        _sp_draw
    done
}

# ── Profile wizard (create or edit) ──────────────────────────────────────────
wizard_profile() {
    _RESULT=""
    local edit="${1:-}"

    printf "\n${BOLD}${Y}  ── %s ──${NC}\n\n" \
        "${edit:+Edit profile: $edit}${edit:-New profile}"

    local pname="$edit"
    if [[ -z "$pname" ]]; then
        read -rp "  Profile name: " pname
        pname="${pname// /_}"
        if [[ -z "$pname" ]]; then printf "${R}  Cancelled.${NC}\n"; return; fi
    fi

    [[ -n "$edit" ]] && load_profile "$edit"

    local accounts first_acc
    accounts=$(detect_accounts)
    first_acc=$(awk '{print $1}' <<< "$accounts")
    [[ -z "$D_ACCOUNT" ]] && \
        printf "  ${C}Available accounts:${NC} %s\n" "${accounts:-<none detected>}"
    while true; do
        prompt "Account" "${D_ACCOUNT:-${first_acc}}" D_ACCOUNT
        [[ -n "$D_ACCOUNT" ]] && break
        printf "  ${R}Account cannot be empty.${NC}\n"
    done

    printf "\n  ${C}Partitions:${NC}\n"
    printf "    berzelius      — GPU nodes (NVIDIA A100)\n"
    printf "    berzelius-cpu  — CPU-only nodes\n"
    prompt "Partition" "$D_PARTITION" D_PARTITION

    local gpu_flag=""
    if [[ "$D_PARTITION" != "cpu" && "$D_PARTITION" != "berzelius-cpu" ]]; then
        prompt "Number of GPUs" "${D_GPUS:-1}" D_GPUS
        gpu_flag="--gpus=$D_GPUS"
    fi
    prompt "Time limit (HH:MM:SS)" "$D_TIME" D_TIME
    prompt "Memory"                "$D_MEM"  D_MEM

    save_profile "$pname"
    printf "${G}  Profile '%s' saved → %s/${NC}\n" "$pname" "$JOBS_DIR/$pname"

    local setup="$JOBS_DIR/$pname/setup.sh"
    if [[ ! -f "$setup" ]]; then
        printf "\n"
        read -rp "  Create a setup.sh? (sourced automatically after allocation starts) [y/N]: " ans
        if [[ "$ans" =~ ^[Yy]$ ]]; then
            cat > "$setup" <<TMPL
#!/bin/bash
# setup.sh for profile: $pname
# Sourced automatically after your SLURM allocation starts.

export PROJECT=/proj/rpl-soro/users/\$USER

# ── Apptainer ──────────────────────────────────────────────────────────────
# apptainer shell --nv \\
#     -B \$PROJECT/ros2_ws:/ros2_ws \\
#     \$PROJECT/containers/$pname.sif

# ── Conda ──────────────────────────────────────────────────────────────────
# conda activate myenv
TMPL
            chmod +x "$setup"
            printf "${G}  Created %s${NC}\n" "$setup"
            printf "${C}  Edit it any time, or press [e] in the profile list.${NC}\n"
        fi
    fi

    _RESULT="$pname"
}

# ── Launch a profile ──────────────────────────────────────────────────────────
launch_profile() {
    local name="$1"
    load_profile "$name"

    # Auto-detect account if not set in profile
    if [[ -z "${D_ACCOUNT:-}" ]]; then
        local detected; detected=$(detect_accounts)
        D_ACCOUNT=$(awk '{print $1}' <<< "$detected")
    fi
    if [[ -z "${D_ACCOUNT:-}" ]]; then
        printf "\n${R}  Could not detect a SLURM account for user '%s'.${NC}\n" "$USER"
        printf "\n  ${DIM}Press any key to return...${NC}"
        IFS= read -rsn1 2>/dev/null || true
        return 1
    fi

    local gpu_flag=""
    [[ "${D_PARTITION:-}" != "cpu" && "${D_PARTITION:-}" != "berzelius-cpu" ]] && gpu_flag="--gpus=${D_GPUS:-1}"

    printf "\n${BOLD}${Y}  Launching: %s${NC}\n" "$name"
    if [[ -n "$gpu_flag" ]]; then
        printf "  ${DIM}%s · %s GPU · %s · %s · account=%s${NC}\n" \
            "$D_PARTITION" "$D_GPUS" "$D_TIME" "$D_MEM" "$D_ACCOUNT"
    else
        printf "  ${DIM}%s · %s · %s · account=%s${NC}\n" \
            "$D_PARTITION" "$D_TIME" "$D_MEM" "$D_ACCOUNT"
    fi

    local -a srun_args=(
        --account="$D_ACCOUNT" --partition="$D_PARTITION"
        --time="$D_TIME" --mem="$D_MEM" --job-name="$name"
    )
    [[ -n "$gpu_flag" ]] && srun_args+=("$gpu_flag")

    printf "\n${Y}  Requesting allocation — waiting for a free node...${NC}\n"
    printf "${C}  (Ctrl-C to cancel)${NC}\n\n"

    local setup="$JOBS_DIR/$name/setup.sh"
    local exit_code=0
    if [[ -f "$setup" ]]; then
        printf "${C}  setup.sh found — will be sourced after login.${NC}\n\n"
        local rc; rc=$(mktemp "$HOME/.bjob_rc_XXXXXX")
        printf 'cd "%s"\n[[ -f ~/.bashrc ]] && source ~/.bashrc\nsource "%s"\n' "$PROJECT" "$setup" > "$rc"
        srun "${srun_args[@]}" --pty bash --rcfile "$rc" || exit_code=$?
        rm -f "$rc"
    else
        srun "${srun_args[@]}" --pty bash || exit_code=$?
    fi

    [[ -n "${hook_pid:-}" ]] && kill "$hook_pid" 2>/dev/null && wait "$hook_pid" 2>/dev/null

    if [[ $exit_code -ne 0 ]]; then
        printf "\n${R}  srun failed (exit %d) — check account/partition/resources.${NC}\n" "$exit_code"
        printf "  ${DIM}Press any key to return...${NC}"
        IFS= read -rsn1 2>/dev/null || true
    fi
}

# ── Connect to a running job ──────────────────────────────────────────────────
connect_job() {
    local jobid="$1" jobname="${2:-}" role="${3:-}"
    [[ -z "$jobname" ]] && jobname="$(job_name_for_id "$jobid")"

    if [[ -z "$jobname" ]]; then
        printf "\n${R}  Could not find running job %s.${NC}\n" "$jobid"
        return 1
    fi

    printf "\n${G}  Connecting to job %s (%s)...${NC}\n" "$jobid" "$jobname"

    if [[ -z "$role" && "$jobname" == "daaam-cosmos" ]]; then
        role="$(select_daaam_cosmos_role)" || return 1
    fi

    if [[ "$role" == "gpu" ]]; then
        gpu_status "$jobid"
        return $?
    fi
    if [[ "$role" == "logs" || "$role" == "log" ]]; then
        log_paths "$jobid" "$jobname"
        return $?
    fi

    local role_script=""
    local -a role_env=()
    if [[ -n "$role" ]]; then
        case "$role" in
            cosmos|server) role_script="$JOBS_DIR/$jobname/start_cosmos.sh" ;;
            daaam|ros|launch|bag|play) role_script="$JOBS_DIR/$jobname/prepare_daaam_shell.sh" ;;
            auto-launch|launch-auto|batch-launch|launch-batches) role_script="$JOBS_DIR/$jobname/auto_ros_launch.sh" ;;
            auto-bag|bag-auto|batch-bag|play-batches) role_script="$JOBS_DIR/$jobname/auto_bag_play.sh" ;;
            auto|auto-all|batch-auto|all) role_script="$JOBS_DIR/$jobname/auto_all.sh" ;;
            shell)        role_script="" ;;
            *)
                printf "${R}  Unknown role '%s'. Try: cosmos, daaam, shell, gpu, logs, auto-launch, auto-bag, auto.${NC}\n" "$role"
                return 1 ;;
        esac
        if [[ -n "$role_script" && ! -f "$role_script" ]]; then
            printf "${R}  Profile '%s' does not define role '%s'.${NC}\n" "$jobname" "$role"
            return 1
        fi
    fi

    if [[ -n "$role_script" && "$role_script" == "$JOBS_DIR/$jobname/auto_"* ]]; then
        if [[ -t 0 && "${BJOB_AUTO_BATCH_PROMPT:-1}" != "0" ]]; then
            prompt_auto_batch_range || return 1
            role_env+=("DAAAM_AUTO_BATCH_START=$_AUTO_BATCH_START" "DAAAM_AUTO_BATCH_END=$_AUTO_BATCH_END" "BJOB_DAAAM_AUTO_BATCH_START=$_AUTO_BATCH_START" "BJOB_DAAAM_AUTO_BATCH_END=$_AUTO_BATCH_END")
        else
            _AUTO_BATCH_START="${DAAAM_AUTO_BATCH_START:-1}"
            _AUTO_BATCH_END="${DAAAM_AUTO_BATCH_END:-7}"
            role_env+=("DAAAM_AUTO_BATCH_START=$_AUTO_BATCH_START" "DAAAM_AUTO_BATCH_END=$_AUTO_BATCH_END" "BJOB_DAAAM_AUTO_BATCH_START=$_AUTO_BATCH_START" "BJOB_DAAAM_AUTO_BATCH_END=$_AUTO_BATCH_END")
        fi
    fi

    # --overlap is the important bit: it allows multiple IDE terminals to create
    # separate job steps inside the same allocation instead of waiting forever.
    if [[ -n "$role_script" ]]; then
        printf "${C}  Role: %s${NC}\n" "$role"
        if [[ ${#role_env[@]} -gt 0 ]]; then
            printf "${C}  Batch range: batch_%s..batch_%s${NC}\n\n" "$_AUTO_BATCH_START" "$_AUTO_BATCH_END"
            srun --overlap --pty --jobid "$jobid" env "${role_env[@]}" bash "$role_script"
        else
            printf "\n"
            srun --overlap --pty --jobid "$jobid" bash "$role_script"
        fi
        return $?
    fi

    local connect="$JOBS_DIR/$jobname/connect.sh"
    local setup="$JOBS_DIR/$jobname/setup.sh"
    if [[ -f "$connect" ]]; then
        printf "${C}  Found connect.sh for '%s' — will be sourced.${NC}\n\n" "$jobname"
        local rc; rc=$(mktemp "$HOME/.bjob_rc_XXXXXX")
        printf 'cd "%s"\n[[ -f ~/.bashrc ]] && source ~/.bashrc\nsource "%s"\n' "$PROJECT" "$connect" > "$rc"
        srun --overlap --pty --jobid "$jobid" bash --rcfile "$rc"
        rm -f "$rc"
    elif [[ -f "$setup" && "$jobname" != "daaam-cosmos" ]]; then
        printf "${C}  Found setup.sh for '%s' — will be sourced.${NC}\n\n" "$jobname"
        local rc; rc=$(mktemp "$HOME/.bjob_rc_XXXXXX")
        printf 'cd "%s"\n[[ -f ~/.bashrc ]] && source ~/.bashrc\nsource "%s"\n' "$PROJECT" "$setup" > "$rc"
        srun --overlap --pty --jobid "$jobid" bash --rcfile "$rc"
        rm -f "$rc"
    else
        srun --overlap --pty --jobid "$jobid" /bin/bash
    fi
}

print_ide_commands() {
    local jobid="$1" jobname="${2:-}"
    [[ -z "$jobname" ]] && jobname="$(job_name_for_id "$jobid")"
    if [[ -z "$jobname" ]]; then
        printf "\n${R}  Could not find running job %s.${NC}\n" "$jobid"
        return 1
    fi

    printf "\n${BOLD}${Y}  IDE terminal commands for job %s (%s)${NC}\n\n" "$jobid" "$jobname"
    if [[ "$jobname" == "daaam-cosmos" ]]; then
        printf "  bjob connect %s\n" "$jobid"
        printf "  bjob logs %s\n" "$jobid"
        printf "\n  ${DIM}Pick cosmos, daaam, shell, gpu, logs, auto-launch, auto-bag, or auto from the menu.${NC}\n"
    else
        printf "  bjob connect %s\n" "$jobid"
        printf "  bjob gpu %s\n" "$jobid"
        printf "  bjob logs %s\n" "$jobid"
    fi
}

gpu_status() {
    local jobid="$1"
    printf "\n${BOLD}${Y}  GPU status for job %s${NC}\n\n" "$jobid"
    srun --overlap --jobid "$jobid" nvidia-smi \
        --query-gpu=index,name,pstate,power.draw,power.limit,utilization.gpu,memory.used,memory.total \
        --format=csv 2>/dev/null || \
    srun --overlap --jobid "$jobid" nvidia-smi
}

log_paths() {
    local jobid="$1" jobname="${2:-}"
    local project="${PROJECT:-/proj/rpl-soro/users/$USER}"
    local log_dir="$project/.cache/bjob-tmux"
    local found=0 file

    [[ -z "$jobname" ]] && jobname="$(job_name_for_id "$jobid" || true)"
    printf "\n${BOLD}${Y}  Log paths for job %s%s${NC}\n\n" "$jobid" "${jobname:+ ($jobname)}"

    if [[ -d "$log_dir" ]]; then
        for file in "$log_dir"/daaam-"$jobid"-*.log "$log_dir"/daaam-"$jobid".log; do
            [[ -e "$file" ]] || continue
            printf "  %s\n" "$file"
            found=1
        done
    fi

    if [[ -d "$project/.cache/daaam-cosmos-auto" ]]; then
        for file in "$project/.cache/daaam-cosmos-auto"/"$jobid"-* "$project/.cache/daaam-cosmos-auto"/"$jobid"; do
            [[ -d "$file" ]] || continue
            printf "  %s/logs\n" "$file"
            found=1
        done
    fi

    if [[ "$jobname" == "cosmos-reason2" || "$jobname" == "daaam-cosmos" || -f "$project/.cache/cosmos-reason2-vllm.log" ]]; then
        printf "  %s\n" "$project/.cache/cosmos-reason2-vllm.log"
        found=1
    fi

    # afk jobs (cosmos-server / daaam-worker) register their state dir
    local reg_file="$project/.bjob/afk-session.$jobid"
    if [[ -f "$reg_file" ]]; then
        local sdir; sdir=$(cat "$reg_file")
        printf "  %s/logs\n" "$sdir"
        printf "    tail -f %s/logs/auto_launch_terminal.log\n" "$sdir"
        printf "    tail -f %s/logs/cosmos-reason2-vllm.log\n" "$sdir"
        found=1
    fi

    if [[ $found -eq 0 ]]; then
        printf "  No bjob tmux log files found yet under %s\n" "$log_dir"
        printf "  DAAAM logs appear after launching or connecting a tmux-backed daaam session.\n"
    fi
}

# ── Cancel a job ──────────────────────────────────────────────────────────────
cancel_job() {
    local jobid="$1" name="$2"
    read -rp "  Really cancel job $jobid ($name)? [y/N]: " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        scancel "$jobid"
        printf "${R}  Job %s cancelled.${NC}\n" "$jobid"
    else
        printf "  Skipped.\n"
    fi
}

# ── New-job handler: profile selector → action loop ───────────────────────────
handle_new_job() {
    while true; do
        if ! select_profile; then return; fi   # q/back → return to main screen

        case "$_RESULT" in
            __new__)
                wizard_profile
                # loop back to show updated selector
                ;;
            __delete__:*)
                local target="${_RESULT#__delete__:}"
                read -rp "  Delete profile '$target'? [y/N]: " yn
                if [[ "$yn" =~ ^[Yy]$ ]]; then
                    rm -rf "${JOBS_DIR:?}/$target"
                    printf "${R}  Profile '%s' deleted.${NC}\n" "$target"
                    printf "\n  ${DIM}Press any key to continue...${NC}"
                    IFS= read -rsn1 2>/dev/null || true
                fi ;;
            __edit__:*)
                local pname="${_RESULT#__edit__:}"
                local setup="$JOBS_DIR/$pname/setup.sh"
                if [[ ! -f "$setup" ]]; then
                    read -rp "  No setup.sh for '$pname'. Create one? [Y/n]: " yn
                    [[ ! "$yn" =~ ^[Nn]$ ]] && wizard_profile "$pname"
                else
                    ${EDITOR:-nano} "$setup"
                fi ;;
            *)
                if [[ "$_RESULT" == "daaam-cosmos" ]]; then
                    local _mode
                    if _mode="$(prompt_afk_launch_mode)"; then
                        if [[ "$_mode" == "afk" ]]; then
                            launch_afk "$_RESULT"
                        else
                            launch_profile "$_RESULT"
                        fi
                    fi
                else
                    launch_profile "$_RESULT"
                fi
                return ;;
        esac
        tput civis 2>/dev/null   # re-hide cursor after any interactive action
    done
}

# ── Main TUI screen ───────────────────────────────────────────────────────────
# Renders the job list as an arrow-key navigable table.
# Returns 1 to quit, 0 to refresh (after any action).
_main_screen() {
    printf '\033[H\033[2J'   # cursor home + erase display (within alternate screen)
    header

    # Fetch and populate global render state
    local raw_jobs
    raw_jobs=$(get_jobs)

    _JIDS=(); _JSTATES=(); _JNAMES=(); _JPARTS=(); _JTIMES=(); _JREASONS=()
    if [[ -n "$raw_jobs" ]]; then
        while IFS='|' read -r jid state jname jpart jtime jreason; do
            _JIDS+=("$jid"); _JSTATES+=("$state"); _JNAMES+=("$jname")
            _JPARTS+=("$jpart"); _JTIMES+=("$jtime"); _JREASONS+=("$jreason")
        done <<< "$raw_jobs"
    fi
    _NJOBS=${#_JIDS[@]}
    _SEL=0

    local nrows=$((_NJOBS + 1))
    local redrawn=$((_NJOBS + 4))   # jobs + divider + new_job + blank + hint

    # Static column header (printed once, outside the redraw loop)
    local cols header_w header
    cols=$(term_cols)
    header_w=$(( cols - 6 ))
    (( header_w < 20 )) && header_w=20
    if (( cols < 70 )); then
        header='JOBID S NAME TIME'
    else
        header='JOBID S NAME TIME NODE/REASON'
    fi
    printf "${BOLD}${C}    %s${NC}\n" "$(trunc_pad "$header" "$header_w")"
    rule_line "$cols" "  "

    _draw
    tput civis 2>/dev/null   # hide cursor before entering key loop

    while true; do
        tput cuu $redrawn
        local key="" seq=""
        IFS= read -rsn1 key 2>/dev/null || true

        case "$key" in
            $'\x1b')
                IFS= read -rsn2 -t 0.1 seq 2>/dev/null || true
                case "$seq" in
                    '[A') (( _SEL > 0       )) && (( _SEL-- )) || true ;;
                    '[B') (( _SEL < nrows-1 )) && (( _SEL++ )) || true ;;
                esac ;;

            '')   # Enter — only acts on "new job" row
                if [[ $_SEL -eq $_NJOBS ]]; then
                    tput cud $redrawn; tput cnorm 2>/dev/null
                    handle_new_job; return 0
                fi ;;

            c|C)  # Connect (RUNNING only)
                if [[ $_SEL -lt $_NJOBS && "${_JSTATES[$_SEL]}" == "RUNNING" ]]; then
                    tput cud $redrawn
                    leave_alt_screen
                    connect_job "${_JIDS[$_SEL]}" "${_JNAMES[$_SEL]}"
                    return 1
                fi ;;

            p|P)  # Print IDE terminal commands
                if [[ $_SEL -lt $_NJOBS && "${_JSTATES[$_SEL]}" == "RUNNING" ]]; then
                    tput cud $redrawn
                    leave_alt_screen
                    print_ide_commands "${_JIDS[$_SEL]}" "${_JNAMES[$_SEL]}"
                    return 1
                fi ;;

            g|G)  # GPU status
                if [[ $_SEL -lt $_NJOBS && "${_JSTATES[$_SEL]}" == "RUNNING" ]]; then
                    tput cud $redrawn
                    leave_alt_screen
                    gpu_status "${_JIDS[$_SEL]}"
                    return 1
                fi ;;

            l|L)  # Log paths
                if [[ $_SEL -lt $_NJOBS && "${_JSTATES[$_SEL]}" == "RUNNING" ]]; then
                    tput cud $redrawn
                    leave_alt_screen
                    log_paths "${_JIDS[$_SEL]}" "${_JNAMES[$_SEL]}"
                    return 1
                fi ;;

            k|K)  # Cancel any job
                if [[ $_SEL -lt $_NJOBS ]]; then
                    tput cud $redrawn; tput cnorm 2>/dev/null
                    cancel_job "${_JIDS[$_SEL]}" "${_JNAMES[$_SEL]}"
                    printf "\n  ${DIM}Press any key to refresh...${NC}"
                    IFS= read -rsn1 2>/dev/null || true
                    return 0
                fi ;;

            r|R)  # Manual refresh
                tput cud $redrawn; tput cnorm 2>/dev/null
                return 0 ;;

            q|Q)
                tput cud $redrawn; tput cnorm 2>/dev/null
                return 1 ;;
        esac

        _draw
    done
}

# ── Main ──────────────────────────────────────────────────────────────────────
main() {
    BJOB_ALT_SCREEN=1
    printf '\033[?1049h'   # enter alternate screen buffer (blank slate, restored on exit)
    tput civis 2>/dev/null # hide cursor once for the whole TUI session
    while true; do
        _main_screen || break
    done
    leave_alt_screen
}

case "${1:-}" in
    connect)
        [[ $# -ge 2 ]] || { usage; exit 2; }
        connect_job "$2" "" "${3:-}" ;;
    cmds|commands)
        [[ $# -ge 2 ]] || { usage; exit 2; }
        print_ide_commands "$2" ;;
    gpu)
        [[ $# -ge 2 ]] || { usage; exit 2; }
        gpu_status "$2" ;;
    logs|log)
        [[ $# -ge 2 ]] || { usage; exit 2; }
        log_paths "$2" ;;
    -h|--help|help)
        usage ;;
    "")
        main ;;
    *)
        usage
        exit 2 ;;
esac
