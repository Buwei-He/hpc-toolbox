#!/bin/bash
# percorso-demo — run the live-demo pipeline on Berzelius against an EGG rosbag.
#
# This file lives at  $PROJECT/berzelius-toolbox/bin/percorso-demo
# and is on PATH via  ~/bin/percorso-demo  (a symlink).  `percorso-demo where`
# prints that plus every other path it uses.
#
# A controlled stand-in for the robot: the bag replaces the sensor, everything
# else (bridge, rolling buffer, mid-run event refresh, remote query) is the real
# demo path. Run this INSIDE a SLURM job on a compute node.
#
#   percorso-demo doctor              verify the demo code is what will actually run
#   percorso-demo run bag [batch] [--snapshot[=N]] [--cosmos reason2|nano]  mock test
#   percorso-demo run live [--snapshot[=N]] [--cosmos reason2|nano]        real demo
#     --snapshot[=N]: also poll the query bridge every N sec (default 30) and
#     write dsg.json/events.yaml snapshots — see tools/snapshot_poller.py.
#     --cosmos: which HOI reasoning backend to query (default reason2) —
#     'reason2' = cosmos-reason2 job (port 8000), 'nano' = cosmos3-nano-reasoner
#     job (port 8001). Either must already be running (bjob submit <profile>).
#   percorso-demo status              what is running on THIS node, and is it healthy
#   percorso-demo where               print the paths this tool uses
#   percorso-demo overlay             one-time: build the demo ROS overlay
#   percorso-demo logs <svc> [-f]     tail a background service's log
#   percorso-demo stop <svc|all>      stop background services
#
# 'run' is the entry point — it picks the params for each mode so nothing has to
# be re-typed. Two ways it can feed the pipeline:
#   'bag'    — bag plays here on the server. Tests the query path only.
#   'stream' — the robot/laptop dials OUT through an ssh-helper tunnel and pushes
#              raw TCP; this side only listens. No zenoh, no ros1_bridge.
#              (tools/stream/receiver + tools/stream/sender.)
# 'stream'/'pipeline'/'bag' still exist directly, for manual control.
#
# Why background services: the documented workflow is ONE tmux window inside ONE
# Apptainer shell inside ONE SLURM job. A second terminal means a second ssh hop
# and re-attaching to a private compute node — so anything that is a daemon
# rather than something you watch (stream) detaches by default and leaves a
# pidfile + log behind. Add --fg to watch it instead; add --bg to detach the
# things that normally run in the foreground.
#
# Why an overlay: the demo ROS package is percorso_perception_ros, built in its own
# workspace next to the paper's daaam_ros. Because the names differ, sourcing order
# no longer decides which one you get and `ros2 launch percorso_perception_ros ...`
# cannot resolve to paper code. What is still chosen by environment is the Python
# lib `daaam` (via PYTHONPATH) — but that one fails loudly: the demo node imports a
# module the paper lib does not have. 'doctor' reports every layer anyway.
#
# Exit: 0 ok · 1 expected failure with the next step · 2 wrong place.

set -uo pipefail

# Resolve through the ~/bin symlink: "where is this file" is the question this
# answers, and the symlink is not the answer you can edit.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
INVOKED_AS="${BASH_SOURCE[0]}"

source "$(dirname "$SELF")/lib/site.sh"
PROJECT="${PROJECT:?PROJECT not set — copy local.config.json.example to local.config.json and fill in project_group, or export PROJECT yourself}"
SIF="${PERCORSO_SIF:-$PROJECT/containers/daaam.sif}"
OVERLAY="${PERCORSO_OVERLAY:-$PROJECT/percorso_overlay}"
DEMO_LIB="${PERCORSO_DEMO_LIB:-/ros2_ws/src/percorso-perception/src}"
DEMO_ROS="${PERCORSO_DEMO_ROS:-$PROJECT/ros2_ws/src/percorso-perception-ros}"
BATCH="${PERCORSO_BATCH:-batch_7}"          # smallest EGG bag — fastest first test
BRIDGE_PORT="${PERCORSO_BRIDGE_PORT:-8100}"
STREAM_PORT="${PERCORSO_STREAM_PORT:-9001}"   # tools/stream/receiver — current transport
STREAM_RECEIVER="${PERCORSO_STREAM_RECEIVER:-$PROJECT/ros2_ws/src/percorso-perception/tools/stream/receiver/ros2_stream_receiver.py}"
# Unset by default: the egg launch file's own odom_frame/sensor_frame defaults
# match the EGG dataset's recorded tf, which is what 'bag' plays. The live
# Odin1 feed needs different names (odin1_odom / odin1_camera_0 — see the
# STATUS note atop tools/stream/receiver/ros2_stream_receiver.py for why they
# carry an odin1_ prefix) — set these two only when running against 'stream'.
ODOM_FRAME="${PERCORSO_ODOM_FRAME:-}"
SENSOR_FRAME="${PERCORSO_SENSOR_FRAME:-}"
RGB_TOPIC="${PERCORSO_RGB_TOPIC:-/cam0/rgb_image}"
DEPTH_TOPIC="${PERCORSO_DEPTH_TOPIC:-/cam0/depth_image}"

# Runtime state is PER NODE on purpose: compute nodes are ephemeral, so a pidfile
# from yesterday's node describes a process that cannot exist. Under $PROJECT so
# it is visible from both inside and outside the container.
RUN_DIR="${PERCORSO_RUN_DIR:-$PROJECT/.percorso/run/$(hostname -s)}"
# DAAAM's own output convention (ROOT_DIR/output/..., src/daaam/__init__.py) —
# a demo run's snapshots sit next to output/egg/, output/hoi4d/, etc., not off
# in the toolbox's own .percorso/ state directory.
SNAPSHOT_DIR="${PERCORSO_SNAPSHOT_DIR:-${DEMO_LIB%/src}/output/snapshot}"
SNAPSHOT_POLLER="${PERCORSO_SNAPSHOT_POLLER:-$PROJECT/ros2_ws/src/percorso-perception/tools/snapshot_poller.py}"

R='\033[0;31m' G='\033[0;32m' Y='\033[1;33m' DIM='\033[2m' NC='\033[0m'
ok()   { printf "${G}  ok${NC}    %s\n" "$*"; }
warn() { printf "${Y}  warn${NC}  %s\n" "$*"; }
note() { printf "${DIM}        %s${NC}\n" "$*"; }

source "$(dirname "$SELF")/lib/power.sh"
source "$(dirname "$SELF")/lib/svc.sh"
SVC_RUN_DIR="$RUN_DIR"
die()  { printf "${R}  fail${NC}  %s\n" "$1" >&2; shift || true
         for l in "$@"; do printf "${DIM}        %s${NC}\n" "$l" >&2; done; exit 1; }

# The one environment recipe that makes the DEMO code win over the paper code:
# overlay sourced AFTER the main install, demo lib prepended to PYTHONPATH.
container_preamble() {
    printf "source /ros2_ws/setup_daaam.sh >/dev/null 2>&1\n"
    printf "[ -f '%s/install/setup.bash' ] && source '%s/install/setup.bash' >/dev/null 2>&1\n" \
           "$OVERLAY" "$OVERLAY"
    printf "export PYTHONPATH='%s':\$PYTHONPATH\n" "$DEMO_LIB"
    printf "export PROJECT='%s'\n" "$PROJECT"
}

# Works whether you are already inside the Apptainer shell or outside it. This
# matters: the documented workflow is `apptainer shell` first, and there is NO
# apptainer binary inside the container, so nesting `apptainer exec` does not
# merely misbehave — it cannot run at all. Detect and run the payload directly.
inside_container() {
    [ -n "${APPTAINER_CONTAINER:-}${SINGULARITY_CONTAINER:-}" ] || [ -d /.singularity.d ]
}

apptainer_argv() {
    printf '%s\n' apptainer exec --nv \
        -B "$PROJECT/ros2_ws:/ros2_ws" \
        -B "$PROJECT/rosbags:/rosbags" \
        -B "$PROJECT:$PROJECT" \
        "$SIF"
}

in_container() {
    # The $'\n' is load-bearing: $(...) strips trailing newlines, so without it the
    # last preamble line and the command are glued into one statement. That failure
    # is silent (the mangled line just exits non-zero and prints nothing), and it
    # cost a debugging round — the background path builds a script file instead and
    # so never hit it, which made the bug look like a broken zenoh binary.
    local payload; payload="$(container_preamble)"$'\n'"$1"
    if inside_container; then
        bash -lc "$payload"
    else
        local argv=(); mapfile -t argv < <(apptainer_argv)
        "${argv[@]}" bash -lc "$payload"
    fi
}

require_job() {
    [ -n "${SLURM_JOB_ID:-}" ] || die "not inside a SLURM job" \
        "this needs a compute node — start one with:  bjob → percorso" \
        "login nodes must not run the pipeline"
}

# Two interchangeable cosmos backends, chosen with `run --cosmos reason2|nano`
# (default reason2, or $PERCORSO_COSMOS). Each writes its own URL file so
# both jobs can be up at once without clobbering each other — see
# jobs/cosmos-reason2/setup.sh and jobs/cosmos3-nano-reasoner/setup.sh.
cosmos_backend_spec() {
    case "${1:-${PERCORSO_COSMOS:-reason2}}" in
        reason2) printf '%s\t%s/.cosmos_url\t8000' cosmos-reason2 "$PROJECT" ;;
        nano)    printf '%s\t%s/.cosmos3_url\t8001' cosmos3-nano-reasoner "$PROJECT" ;;
        *)       die "unknown cosmos backend '$1'" "use 'reason2' or 'nano'" ;;
    esac
}

cosmos_url() {
    if [ -n "${COSMOS_URL:-}" ]; then printf '%s' "$COSMOS_URL"; return; fi
    local jobname urlfile port
    IFS=$'\t' read -r jobname urlfile port < <(cosmos_backend_spec) || return 1
    [ -s "$urlfile" ] && tr -d '\n' < "$urlfile"
}

# Exact job-name match, not a substring: 'cosmos' would also match 'daaam-cosmos'
# and point at the wrong node. Unavailable inside the container — there is no
# squeue in there, which is why the URL travels through a file at all.
cosmos_node() {
    command -v squeue >/dev/null 2>&1 || return 1
    local jobname urlfile port
    IFS=$'\t' read -r jobname urlfile port < <(cosmos_backend_spec) || return 1
    squeue -u "$USER" -h -o "%j|%T|%N" 2>/dev/null \
      | awk -F'|' -v j="$jobname" '$1==j && $2=="RUNNING" && $3!="" {print $3; exit}'
}

# Called only when the recorded URL does not answer. The url file is written
# by cosmos at boot, so after a job restart it can name a node that runs nothing —
# the "came back days later, no idea where to start" case. Say which of the two it
# is instead of just "not answering".
cosmos_diagnose() {
    local url="$1" host node jobname urlfile port
    IFS=$'\t' read -r jobname urlfile port < <(cosmos_backend_spec)
    host=${url#*://}; host=${host%%:*}
    if node=$(cosmos_node) && [ -n "$node" ]; then
        if [ "$node" != "$host" ]; then
            note "SLURM says $jobname runs on '$node', but the URL names '$host'"
            note "the recorded URL is stale — cosmos rewrites it at boot"
            note "use the live one:  export COSMOS_URL=http://$node:$port/v1"
        else
            note "$jobname is on $node but not answering yet — still loading weights?"
        fi
        return
    fi
    [ -s "$urlfile" ] \
        && note "recorded $(date -r "$urlfile" '+%Y-%m-%d %H:%M') in $urlfile"
    if command -v squeue >/dev/null 2>&1; then
        note "no RUNNING $jobname job — start it:  bjob submit $jobname"
    else
        note "no squeue in the container; check from a login node:  squeue -u $USER"
        note "if cosmos just started, the URL file is rewritten at boot — wait and retry"
    fi
}

# ── background services ───────────────────────────────────────────────────────
# svc_pidfile/logfile/pid/tcp_open/svc_wait_port/svc_log_tail/svc_stop and the
# generic half of svc_start now live in bin/lib/svc.sh (SVC_RUN_DIR is set to
# $RUN_DIR above). This wrapper adds the one thing that's specific to this
# tool: every service here runs inside the apptainer container, so the
# payload gets container_preamble sourced ahead of it, and — depending on
# whether we're already inside the shell — either runs directly or through
# an apptainer_argv-wrapped launcher.
svc_start_container() {
    local name="$1" cmd="$2"
    local -a launcher=()
    inside_container || mapfile -t launcher < <(apptainer_argv)
    svc_start "$name" "$cmd" "$(container_preamble)" "${launcher[@]}"
}

SERVICES="stream pipeline bag snapshot power netcheck"

# ── where ─────────────────────────────────────────────────────────────────────
cmd_where() {
    printf "percorso-demo — paths in use on %s\n\n" "$(hostname -s)"
    printf "  this file   %s\n" "$SELF"
    printf "  invoked as  %s\n" "$INVOKED_AS"
    printf "  on PATH as  %s\n" "$(command -v percorso-demo || echo '(not on PATH)')"
    printf "  edit with   \$EDITOR %s\n\n" "$SELF"
    printf "  PROJECT     %s\n" "$PROJECT"
    printf "  container   %s\n" "$SIF"
    printf "  overlay     %s\n" "$OVERLAY"
    printf "  demo lib    %s\n" "$DEMO_LIB"
    printf "  demo ros    %s\n" "$DEMO_ROS"
    printf "  run dir     %s\n" "$RUN_DIR"
    printf "\n"
    note "run dir is per-node; pids/logs for services started here live in it"
    note "the companion tool for the laptop side is ssh-helper (in percorso-perception/tools)"
}

# ── overlay ───────────────────────────────────────────────────────────────────
cmd_overlay() {
    [ -d "$DEMO_ROS" ] || die "demo ROS package not found at $DEMO_ROS" \
        "expected the percorso-perception-ros worktree"
    mkdir -p "$OVERLAY/src"
    # Link name is cosmetic (colcon reads package.xml, not directory names), so it
    # matches the directory instead of impersonating the paper package.
    rm -f "$OVERLAY/src/daaam_ros"          # remove the old disguised link
    ln -sfn "$DEMO_ROS" "$OVERLAY/src/$(basename "$DEMO_ROS")"
    printf "building the demo ROS overlay in %s\n" "$OVERLAY"
    note "pure ament_cmake, no compilation — takes ~20 s"
    if in_container "cd '$OVERLAY' && colcon build --symlink-install --packages-select percorso_perception_ros"; then
        ok "overlay built"
        note "re-run this only if you change package.xml / CMakeLists (py + launch edits are live)"
    else
        die "overlay build failed" "check the colcon output above"
    fi
}

# ── doctor ────────────────────────────────────────────────────────────────────
cmd_doctor() {
    printf "percorso-demo doctor — %s\n\n" "$(hostname -s)"
    local fails=0

    if inside_container; then
        ok "running INSIDE the Apptainer shell (${APPTAINER_NAME:-container})"
        # The bjob shell is a PAPER environment on purpose (it must stay able to
        # reproduce the paper). percorso-demo layers the demo env on per command,
        # so everything below describes what PERCORSO-DEMO will run — not what a
        # command you type yourself in this shell would run.
        case ":${PYTHONPATH:-}:" in
            *":$DEMO_LIB:"*) : ;;
            *) note "this shell itself is the paper env: 'ros2 launch daaam_ros ...'"
               note "runs the PAPER pipeline. The demo is percorso_perception_ros." ;;
        esac
    else
        ok "running outside the container — will use apptainer exec"
        [ -f "$SIF" ] || die "no container at $SIF"
    fi

    if [ -f "$OVERLAY/install/setup.bash" ]; then
        ok "overlay present"
    else
        warn "no overlay — the PAPER node would run instead of the demo one"
        note "fix:  percorso-demo overlay"
        fails=$((fails+1))
    fi

    # Only needed for 'percorso-demo bag' (local replay). With the robot feeding
    # over 'stream' the bag isn't needed, so a missing local bag is not a failure.
    local bag="$PROJECT/ros2_ws/data/EGG-Dataset/bags/egg_${BATCH}_full.bag"
    if [ -e "$bag" ]; then
        ok "local bag available for 'bag' mode ($(basename "$bag"), $(du -sh "$bag" 2>/dev/null | cut -f1))"
    else
        note "no local bag for '$BATCH' — fine if the robot is feeding over 'stream'"
    fi

    # The decisive check: what will the demo launch actually execute?
    printf "\n  resolving what will really run:\n"
    local report
    report=$(in_container '
        NODE=$(readlink -f $(ros2 pkg prefix percorso_perception_ros)/lib/percorso_perception_ros/daaam_node.py 2>/dev/null)
        LIB=$(python3 -c "import daaam,pathlib;print(pathlib.Path(daaam.__file__).parent)" 2>/dev/null)
        LAUNCH=$(ros2 pkg prefix percorso_perception_ros)/share/percorso_perception_ros/launch/egg_daaam_hydra.launch.yaml
        printf "node|%s\n" "$NODE"
        printf "lib|%s\n" "$LIB"
        printf "bridge|%s\n" "$(grep -c LiveQueryBridge "$NODE" 2>/dev/null || echo 0)"
        printf "args|%s\n" "$(grep -c enable_live_hoi_query "$LAUNCH" 2>/dev/null || echo 0)"
        SHARE=$(ros2 pkg prefix percorso_perception_ros)/share/percorso_perception_ros
        printf "hydra|%s\n" "$(readlink -f "$SHARE/config/hydra_config/egg_dataset_khronos_dynamic.yaml" 2>/dev/null)"
        printf "engine|%s\n" "$(ls '"${DEMO_LIB%/src}"'/checkpoints/fastsam/*.engine 2>/dev/null | head -1)"
        printf "labels|%s\n" "$([ -r "$SHARE/config/labels_pseudo.yaml" ] && [ -r "$SHARE/config/labels_pseudo.csv" ] && echo "$SHARE/config/labels_pseudo.yaml")"
    ' 2>/dev/null)

    local node lib bridge args engine labels hydra
    node=$(printf '%s' "$report"   | awk -F'|' '$1=="node"{print $2}')
    lib=$(printf '%s' "$report"    | awk -F'|' '$1=="lib"{print $2}')
    bridge=$(printf '%s' "$report" | awk -F'|' '$1=="bridge"{print $2}')
    args=$(printf '%s' "$report"   | awk -F'|' '$1=="args"{print $2}')
    engine=$(printf '%s' "$report" | awk -F'|' '$1=="engine"{print $2}')
    hydra=$(printf '%s' "$report"  | awk -F'|' '$1=="hydra"{print $2}')
    labels=$(printf '%s' "$report" | awk -F'|' '$1=="labels"{print $2}')

    case "$node" in
        *percorso-perception-ros*) ok "node  → demo   ($node)" ;;
        "") warn "percorso_perception_ros not found — the overlay is missing"
            note "fix:  percorso-demo overlay"
            note "(it can no longer silently fall back to the paper package: the names differ)"
            fails=$((fails+1)) ;;
        *)  warn "node resolved outside the demo worktree ($node)"; fails=$((fails+1)) ;;
    esac
    case "$lib" in
        *percorso-perception*) ok "daaam → demo   ($lib)" ;;
        "") warn "could not import daaam"; fails=$((fails+1)) ;;
        *)  warn "daaam → PAPER  ($lib)"; fails=$((fails+1)) ;;
    esac
    [ "${bridge:-0}" -gt 0 ] 2>/dev/null && ok "node contains LiveQueryBridge" \
        || { warn "node has no LiveQueryBridge — wrong code"; fails=$((fails+1)); }
    [ "${args:-0}" -gt 0 ] 2>/dev/null && ok "launch file accepts enable_live_hoi_query" \
        || { warn "launch file lacks the live args"; fails=$((fails+1)); }

    # Configs travel separately from code: the launch file resolves them through
    # find-pkg-share, so a stale absolute override can feed PAPER configs to a run
    # whose node and lib are both correctly demo. That happened; hence this check.
    case "$hydra" in
        *percorso-perception-ros*) ok "hydra cfg → demo   ($hydra)" ;;
        "") warn "could not resolve the hydra config"; fails=$((fails+1)) ;;
        *)  warn "hydra cfg → PAPER  ($hydra)"
            note "the overlay is stale, or something passes hydra_config_path explicitly"
            fails=$((fails+1)) ;;
    esac

    # Untracked/ignored data files. `git worktree` materialises only TRACKED files,
    # so a demo worktree can look perfectly correct and still die at init. Both of
    # these did exactly that; checking here beats grepping a launch log for one
    # FileNotFoundError.
    if [ -n "$engine" ]; then
        ok "segmenter engine  ($engine)"
    else
        warn "no FastSAM .engine in ${DEMO_LIB%/src}/checkpoints/fastsam/"
        note "untracked in the paper repo, so the worktree never got it — link it:"
        note "  ln -sfn ../daaam/checkpoints ${DEMO_LIB%/src}/checkpoints"
        note "without it daaam_node dies at init with FileNotFoundError"
        fails=$((fails+1))
    fi
    if [ -n "$labels" ]; then
        ok "labelspace       (labels_pseudo.yaml + .csv)"
    else
        warn "labels_pseudo.yaml/.csv missing from the overlay share dir"
        note "gitignored in the paper repo; copy the built pair into the demo config:"
        note "  cp $PROJECT/ros2_ws/install/daaam_ros/share/daaam_ros/config/labels_pseudo.* \\"
        note "     $DEMO_ROS/config/  &&  percorso-demo overlay"
        note "without them hydra_ros_node aborts: Virtual config 'sensor' is not set"
        fails=$((fails+1))
    fi

    printf "\n"
    local cu; cu=$(cosmos_url)
    if [ -n "$cu" ]; then
        if curl -sf -m 5 -o /dev/null "${cu%/v1}/health" 2>/dev/null; then
            ok "cosmos healthy at $cu"
        else
            warn "cosmos URL known ($cu) but not answering"
            cosmos_diagnose "$cu"
            fails=$((fails+1))
        fi
    else
        local jobname urlfile port
        IFS=$'\t' read -r jobname urlfile port < <(cosmos_backend_spec)
        warn "no cosmos URL — $urlfile is missing"
        note "start it:  bjob submit $jobname"
        fails=$((fails+1))
    fi

    # Server-side facts, so they belong here rather than in a client tool:
    # so they belong in the server-side tool rather than in the robot's client.
    if [ -n "${SLURM_JOB_ID:-}" ]; then
        ok "inside SLURM job $SLURM_JOB_ID"
    else
        warn "no SLURM_JOB_ID — a login node cannot host the pipeline"
        note "get a compute node:  bjob → percorso profile"
        fails=$((fails+1))
    fi
    if curl -s -m 10 -o /dev/null -w '%{http_code}' https://api.openai.com/v1/models 2>/dev/null \
        | grep -qE '^[1-5][0-9][0-9]$'; then
        ok "outbound HTTPS works from this node"
    else
        warn "no outbound HTTPS — event grouping / semantic naming cannot call a hosted LLM"
        note "the pipeline still runs; only those two stages are affected"
        fails=$((fails+1))
    fi
    # A bound bridge port is only a problem if it is not OUR bridge already.
    if curl -sf -m 3 -o /dev/null "http://127.0.0.1:$BRIDGE_PORT/status" 2>/dev/null; then
        ok "bridge port $BRIDGE_PORT already serving — a pipeline is running here"
    elif python3 -c "
import socket,sys
s=socket.socket(); s.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1)
try: s.bind(('0.0.0.0',$BRIDGE_PORT)); s.close()
except OSError as e: print(e); sys.exit(1)" 2>/dev/null; then
        ok "bridge port $BRIDGE_PORT is free"
    else
        warn "cannot bind 0.0.0.0:$BRIDGE_PORT and nothing answers there"
        note "something else holds it — pick another:  PERCORSO_BRIDGE_PORT=<port>"
        fails=$((fails+1))
    fi

    printf "\n"
    [ "$fails" -eq 0 ] && { ok "ready — percorso-demo stream, then percorso-demo pipeline"; return 0; }
    die "$fails check(s) failed — fix the warnings above first"
}

# ── status ────────────────────────────────────────────────────────────────────
cmd_status() {
    printf "percorso-demo status — %s (job %s)\n\n" "$(hostname -s)" "${SLURM_JOB_ID:-none}"
    local svc pid
    for svc in $SERVICES; do
        if pid=$(svc_pid "$svc"); then
            ok "$svc  running (pid $pid)"
        else
            note "$svc  not running here"
        fi
    done
    printf "\n"
    if tcp_open "$STREAM_PORT"; then
        ok "stream receiver port $STREAM_PORT is accepting connections"
    else
        note "nothing on stream port $STREAM_PORT — start it:  percorso-demo stream"
    fi
    if curl -sf -m 3 -o /dev/null "http://127.0.0.1:$BRIDGE_PORT/status" 2>/dev/null; then
        ok "live query bridge answering on $BRIDGE_PORT"
    else
        note "no live query bridge on $BRIDGE_PORT — start it:  percorso-demo pipeline"
    fi
    local cu; cu=$(cosmos_url)
    if [ -n "$cu" ] && curl -sf -m 5 -o /dev/null "${cu%/v1}/health" 2>/dev/null; then
        ok "cosmos healthy at $cu"
    else
        note "cosmos not answering (${cu:-no URL known})"
        [ -n "$cu" ] && cosmos_diagnose "$cu"
    fi
    printf "\n"
    note "logs:  percorso-demo logs <svc> [-f]      dir: $RUN_DIR"
    note "from the laptop:  ssh-helper connect <node> stream && ssh-helper connect <node> bridge"
}

# ── logs / stop ───────────────────────────────────────────────────────────────
cmd_logs() {
    local name="${1:-}" lf
    [ -n "$name" ] || die "which service?" "one of: $SERVICES"
    lf=$(svc_logfile "$name")
    [ -e "$lf" ] || die "no log for '$name' at $lf" \
        "it was never started on this node (run dir is per-node)"
    if [ "${2:-}" = "-f" ] || [ "${2:-}" = "--follow" ]; then
        printf "${DIM}tail -f %s — Ctrl-C to stop watching (the service keeps running)${NC}\n" "$lf"
        tail -f "$lf"
    else
        tail -n "${2:-60}" "$lf"
    fi
}

cmd_stop() {
    local name="${1:-}"
    [ -n "$name" ] || die "stop what?" "a service name ($SERVICES) or 'all'"
    if [ "$name" = "all" ]; then
        local svc
        for svc in $SERVICES; do svc_stop "$svc"; done
        return 0
    fi
    svc_stop "$name"
}

# ── pipeline ──────────────────────────────────────────────────────────────────
cmd_pipeline() {
    # A LABEL, not a batch: with 'stream' feeding, the bag is on the robot and the
    # server has no bag at all. It only names the output directory. ('scene' is
    # declared but never used by the egg launch file, so it is not passed.)
    local label="live" bg=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --bg) bg=1 ;;
            --fg) bg="" ;;
            -*)   die "unknown option '$1'" "pipeline takes [label] [--bg]" ;;
            *)    label="$1" ;;
        esac
        shift
    done
    require_job
    local cu; cu=$(cosmos_url)
    [ -n "$cu" ] || die "no cosmos URL" "start cosmos first (bjob submit cosmos-reason2|cosmos3-nano-reasoner), or export COSMOS_URL=http://<node>:<port>/v1"

    printf "percorso-demo pipeline — run '%s' on %s\n" "$label" "$(hostname -s)"
    note "cosmos:  $cu (backend: ${PERCORSO_COSMOS:-reason2})"
    note "bridge:  http://$(hostname -s):$BRIDGE_PORT"
    note "frames: percorso-demo stream (remote robot), or bag (local)"
    note "from your laptop:  ssh-helper connect <node> bridge"
    printf "\n"

    # exit_after_clock=false on purpose: when the bag ends we want the node ALIVE
    # so the last 30 s stays queryable. Sim time freezes, which is harmless here.
    # hydra_config_path / input_config_path are deliberately NOT passed. The launch
    # file defaults them to $(find-pkg-share daaam_ros)/config/..., which resolves
    # through the overlay to the DEMO worktree. Passing the absolute
    # /ros2_ws/src/daaam_ros/... paths (as the paper automation does) silently fed
    # the PAPER configs to the demo run — an edit in percorso-perception-ros/config
    # would have had no effect at all. The default is also self-correcting: it
    # follows the overlay instead of an absolute path that can rot.
    local cmd="ros2 launch percorso_perception_ros egg_daaam_hydra.launch.yaml \
          depth_scale:=1000.0 \
          exit_after_clock:=false \
          verbosity:=1 \
          save_human_clips:=true \
          enable_cosmos_hoi_processing:=true \
          cosmos_hoi_base_url:='$cu' \
          cosmos_hoi_media_root:='$PROJECT' \
          defer_dsg_processing:=false \
          enable_live_hoi_query:=true \
          live_buffer_sec:=30.0 \
          live_bridge_port:=$BRIDGE_PORT \
          enable_live_event_refresh:=true \
          event_refresh_interval_sec:=120.0 \
          output_run_prefix:=demo_${label}_"
    [ -n "$ODOM_FRAME" ]   && cmd="$cmd odom_frame:='$ODOM_FRAME'"
    [ -n "$SENSOR_FRAME" ] && cmd="$cmd sensor_frame:='$SENSOR_FRAME'"
    if [ -n "$ODOM_FRAME$SENSOR_FRAME" ]; then
        note "frame override: odom_frame=${ODOM_FRAME:-<launch default>} sensor_frame=${SENSOR_FRAME:-<launch default>}"
    fi

    if [ -z "$bg" ]; then
        in_container "$cmd"
        return
    fi
    svc_start_container pipeline "$cmd" || return 1
    # Model load + TensorRT warmup dominate here, so allow far longer than zenoh.
    if svc_wait_port pipeline "$BRIDGE_PORT" 180; then
        ok "live query bridge answering on $(hostname -s):$BRIDGE_PORT"
        note "watch it:  percorso-demo logs pipeline -f"
    else
        note "still starting? watch it:  percorso-demo logs pipeline -f"
        return 1
    fi
}

# ── bag ───────────────────────────────────────────────────────────────────────
cmd_bag() {
    local batch="$BATCH" loop="" bg=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --loop) loop="--loop" ;;
            --bg)   bg=1 ;;
            -*)     die "unknown option '$1'" "bag takes [batch] [--loop] [--bg]" ;;
            *)      batch="$1" ;;
        esac
        shift
    done
    require_job
    local bag="/ros2_ws/data/EGG-Dataset/bags/egg_${batch}_full.bag"
    printf "percorso-demo bag — %s%s\n" "$batch" "${loop:+ (looping)}"
    note "the pipeline must already be up and printing 'Waiting for CameraInfo'"
    printf "\n"
    local cmd="ros2 bag play '$bag' --clock \
          --qos-profile-overrides-path /ros2_ws/tools/egg_bag_qos_overrides.yaml $loop"
    if [ -n "$bg" ]; then
        # Nothing to probe: a bag player opens no port. Report the pid and move on.
        svc_start_container bag "$cmd" || return 1
        ok "bag replaying in the background"
        note "watch it:  percorso-demo logs bag -f"
        return 0
    fi
    in_container "$cmd"
}

# ── run (one command — the params for each mode are picked for you) ───────────
# 'bag'  — mock test, no robot: starts the pipeline in the background against
#          dataset-shaped defaults, waits for it to be ready, then plays the
#          batch HERE (foreground). Ctrl-C or a finished bag leaves the
#          pipeline running and queryable — 'percorso-demo stop pipeline' when done.
# 'live' — real demo: starts the stream receiver, points the pipeline at
#          Odin1's own tf frames (override with PERCORSO_ODOM_FRAME /
#          PERCORSO_SENSOR_FRAME if that's ever wrong), runs the pipeline in
#          the foreground.
# Replaces remembering odom/sensor frame vars and the doctor->stream->pipeline
# or doctor->pipeline--bg->bag command order by hand; 'pipeline'/'bag'/'stream'
# below still exist for manual control (debugging, a non-default batch mid-run,
# scripting).
cmd_run() {
    local usage="run takes: bag [batch] [--loop] [--snapshot[=N]] [--cosmos reason2|nano] | live [--bg] [--snapshot[=N]] [--cosmos reason2|nano]"
    local mode="${1:?$usage}"; shift
    local batch="$BATCH" loop="" bg="" snapshot_interval=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --snapshot)   snapshot_interval=30 ;;
            --snapshot=*) snapshot_interval="${1#--snapshot=}" ;;
            --loop)       loop="--loop" ;;
            --bg)         bg=1 ;;
            --cosmos)     PERCORSO_COSMOS="${2:?--cosmos needs reason2 or nano}"; shift ;;
            --cosmos=*)   PERCORSO_COSMOS="${1#--cosmos=}" ;;
            -*)           die "unknown option '$1'" "$usage" ;;
            *)            batch="$1" ;;
        esac
        shift
    done
    cosmos_backend_spec "${PERCORSO_COSMOS:-}" >/dev/null
    export PERCORSO_COSMOS="${PERCORSO_COSMOS:-reason2}"

    case "$mode" in
        bag)
            note "run bag — mock test against '$batch', no robot needed"
            cmd_pipeline "$batch" --bg || return 1
            if [ -n "$snapshot_interval" ]; then
                cmd_snapshot --interval "$snapshot_interval" --out "$SNAPSHOT_DIR/$batch" || return 1
            fi
            cmd_bag "$batch" $loop
            ;;
        live)
            note "run live — real robot feed"
            cmd_stream || return 1
            ODOM_FRAME="${PERCORSO_ODOM_FRAME:-odin1_odom}"
            SENSOR_FRAME="${PERCORSO_SENSOR_FRAME:-odin1_camera_0}"
            note "frames: odom=$ODOM_FRAME sensor=$SENSOR_FRAME"
            note "(override with PERCORSO_ODOM_FRAME / PERCORSO_SENSOR_FRAME if ARI's own frames differ)"
            if [ -n "$snapshot_interval" ]; then
                # Started before the bridge is confirmed up on purpose: a
                # foreground pipeline blocks this shell, so there is no "after
                # it's ready" moment to hook. The poller's own retry loop
                # already tolerates a bridge that isn't answering yet.
                cmd_snapshot --interval "$snapshot_interval" || return 1
            fi
            if [ -n "$bg" ]; then cmd_pipeline --bg; else cmd_pipeline; fi
            ;;
        *) die "unknown mode '$mode'" "$usage" ;;
    esac
}

# ── stream (raw TCP push over an ssh-helper tunnel — current transport) ───────
# The receiver half of tools/stream/receiver + tools/stream/sender.
# Compute nodes take no inbound connections, so this side only LISTENS — the
# robot/laptop dials out through an ssh-helper tunnel. No zenoh, no ros1_bridge:
# ROS1 messages are decoded by hand (see the receiver's own docstring) and
# republished as native ROS2 topics — $RGB_TOPIC, $DEPTH_TOPIC, their
# camera_info, plus /tf, /tf_static, /clock.
cmd_stream() {
    local fg=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --fg) fg=1 ;;
            --bg) fg="" ;;
            *)    die "unknown option '$1'" "stream takes [--fg]" ;;
        esac
        shift
    done
    require_job
    [ -f "$STREAM_RECEIVER" ] || die "no receiver at $STREAM_RECEIVER"

    local cmd="python3 '$STREAM_RECEIVER' --port $STREAM_PORT"

    printf "percorso-demo stream — receiver on %s:%s\n" "$(hostname -s)" "$STREAM_PORT"
    note "on the robot/laptop: ssh-helper connect $(hostname -s) stream"
    note "                     python3 tools/stream/sender/ros1_stream_sender.py --receiver-port $STREAM_PORT"
    printf "\n"

    if [ -n "$fg" ]; then
        note "foreground: this terminal is now the receiver's; Ctrl-C stops it"
        in_container "$cmd"
        return
    fi

    svc_start_container stream "$cmd" || return 1
    svc_wait_port stream "$STREAM_PORT" 15 || return 1
    ok "receiver listening on $(hostname -s):$STREAM_PORT — this terminal is free"
    printf "\n"
    note "next, here:      PERCORSO_ODOM_FRAME=odin1_odom PERCORSO_SENSOR_FRAME=odin1_camera_0 percorso-demo pipeline"
    note "(the frame vars matter: Odin1's own tf tree is unrelated to ARI's, see"
    note " tools/stream/receiver/ros2_stream_receiver.py's docstring)"
    note "watch / stop:    percorso-demo logs stream -f  ·  percorso-demo stop stream"
}

# ── snapshot (periodic on-disk capture of the live query bridge) ──────────────
# tools/snapshot_poller.py polling /dsg /events /interactions /status; writes
# DAAAM's own dsg.json/events.yaml formats so scripts/export_rerun_output.py
# visualizes any snapshot directory unmodified. Usually started for you by
# 'run bag|live --snapshot[=N]', not called directly.
cmd_snapshot() {
    local interval=30 out="$SNAPSHOT_DIR/live" fg=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --interval) interval="${2:?--interval needs seconds}"; shift ;;
            --out)      out="${2:?--out needs a path}"; shift ;;
            --fg)       fg=1 ;;
            --bg)       fg="" ;;
            *) die "unknown option '$1'" "snapshot [--interval N] [--out DIR] [--fg]" ;;
        esac
        shift
    done
    require_job
    [ -f "$SNAPSHOT_POLLER" ] || die "no poller at $SNAPSHOT_POLLER"

    local cmd="python3 '$SNAPSHOT_POLLER' --base-url http://127.0.0.1:$BRIDGE_PORT --interval $interval --out '$out'"

    printf "percorso-demo snapshot — every %ss -> %s\n" "$interval" "$out"

    if [ -n "$fg" ]; then in_container "$cmd"; return; fi
    # Nothing to probe: a poller opens no port. Report the pid and move on —
    # its own retry loop handles a bridge that isn't answering yet.
    svc_start_container snapshot "$cmd" || return 1
    ok "snapshot poller running — 'percorso-demo logs snapshot -f' to watch"
}

# ── netcheck (is the link fast enough to bother building the rest?) ───────────
# The whole remote-feed design rests on one unmeasured number: how much uplink
# the robot actually gets to a compute node through the ssh tunnel. Everything
# else is decided — 4.05 Mbit/s for 640x480 rgb + native 240x160 depth, measured
# on real frames. So this is a go/no-go, not a curiosity.
#
# iperf3 is NOT in the container (only on the host), so unlike every other
# service here this one runs outside it.
#
# Interpreting the result:
#   >= 10 Mbit/s  comfortable: the 640x480 plan fits with headroom for jitter
#    4 - 10       tight but workable; drop to q70 and/or 2.5 Hz on both streams
#   <  4          the tunnel is not the transport. Fall back to a campus-hosted
#                 server — and note that a reachable campus box also removes the
#                 tunnel entirely, because compute nodes have OUTBOUND access
#                 and can dial out to it instead.
NETCHECK_PORT="${PERCORSO_NETCHECK_PORT:-5201}"

# iperf3 is on the cluster HOSTS but not in the container image, and the
# documented workflow puts you inside the container (bjob -> apptainer shell)
# with no way back out — there is no apptainer binary in there to nest with. So
# the container case needs a listener that depends on nothing but python3, which
# is what this is. The laptop pushes with nc or dd; no matching tool required.
netcheck_sink_py() {
    cat <<'SINKPY'
import socket, sys, time

port = int(sys.argv[1])
srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
srv.bind(("0.0.0.0", port))
srv.listen(1)
print("sink listening on 0.0.0.0:%d — waiting for a push" % port, flush=True)

while True:
    conn, addr = srv.accept()
    print("connection from %s" % addr[0], flush=True)
    total = 0
    t0 = last = time.monotonic()
    last_total = 0
    try:
        while True:
            buf = conn.recv(1 << 20)
            if not buf:
                break
            total += len(buf)
            now = time.monotonic()
            if now - last >= 1.0:
                print("  %8.2f Mbit/s   (%8.1f MB so far)"
                      % ((total - last_total) * 8 / (now - last) / 1e6, total / 1e6),
                      flush=True)
                last, last_total = now, total
    except Exception as exc:
        print("  connection error: %s" % exc, flush=True)
    finally:
        conn.close()
    dt = time.monotonic() - t0
    if dt > 0 and total > 0:
        print("DONE  %.1f MB in %.1fs  =  %.2f Mbit/s mean"
              % (total / 1e6, dt, total * 8 / dt / 1e6), flush=True)
    print("still listening — run it again for a second sample", flush=True)
SINKPY
}

cmd_netcheck() {
    local port="$NETCHECK_PORT"
    while [ $# -gt 0 ]; do
        case "$1" in
            --port) port="${2:?--port needs a number}"; shift ;;
            -*) die "unknown option '$1'" "netcheck [--port N]" ;;
            *)  die "unexpected argument '$1'" "netcheck [--port N]" ;;
        esac
        shift
    done
    require_job

    # Initialised, not just declared: `local mode` leaves it UNSET, and under
    # set -u the container path (no override, no iperf3) reads it before either
    # branch assigns it — an unbound-variable abort exactly where this is meant
    # to run.
    local node cmd="" mode=""
    node=$(hostname -s)
    # PERCORSO_NETCHECK_MODE=sink forces the python listener even where iperf3
    # exists — useful when the laptop has no iperf3 to drive it with.
    if [ "${PERCORSO_NETCHECK_MODE:-}" = sink ]; then
        mode=sink
    elif command -v iperf3 >/dev/null 2>&1; then
        mode=iperf3
        cmd="iperf3 -s -p $port"
    fi
    if [ "$mode" != iperf3 ]; then
        mode=sink
        local py="$RUN_DIR/netcheck_sink.py"
        mkdir -p "$RUN_DIR"
        netcheck_sink_py > "$py"
        cmd="python3 '$py' $port"
        if command -v iperf3 >/dev/null 2>&1; then
            note "iperf3 is here, but PERCORSO_NETCHECK_MODE=sink asked for the sink"
        else
            note "no iperf3 here (it is on the cluster hosts, not in the container),"
            note "so this uses a built-in TCP sink — python3 is all it needs"
            note "for real iperf3 you would need a HOST shell on this node, from a login node:"
            note "  srun --jobid=${SLURM_JOB_ID:-<id>} --overlap -n1 iperf3 -s -p $port"
        fi
    fi

    # Empty preamble and no launcher: run the listener in whatever environment
    # this tool was invoked from, host or container. Both work.
    svc_start netcheck "$cmd" "" || return 1
    svc_wait_port netcheck "$port" 10 || return 1
    ok "listener up on $node:$port  (mode: $mode)"
    printf "\n"
    printf "  On the laptop — UPLINK is the number that matters (the robot sends):\n\n"
    printf "    ssh-helper connect %s %s\n\n" \
           "$node" "$port"
    if [ "$mode" = iperf3 ]; then
        printf "    iperf3 -c 127.0.0.1 -p %s -t 20          # laptop -> Berzelius\n" "$port"
        printf "    iperf3 -c 127.0.0.1 -p %s -t 20 -R       # the other direction\n" "$port"
    else
        # Time-bounded, not size-bounded: a fixed 200 MB is 6 seconds on a fast
        # link and seven minutes on a slow one, and the slow case is the one
        # worth measuring. 20 s gives ~20 per-second samples either way.
        printf "    timeout 20 bash -c 'dd if=/dev/zero bs=1M | nc 127.0.0.1 %s'\n\n" "$port"
        note "no nc on the laptop? any tool that opens a TCP socket and writes"
        note "zeros for 20 s does the job — python3 socket.create_connection()"
        printf "\n"
        note "the RESULT PRINTS HERE, not on the laptop:"
        note "  percorso-demo logs netcheck -f"
        note "uplink only — a sink cannot measure the reverse direction"
    fi
    printf "\n"
    note "need >= 4.05 Mbit/s sustained for 640x480 rgb + native 240x160 depth"
    note "10+ is comfortable; under 4 means the tunnel is not the transport"
    printf "\n"
    note "then compare against the same ssh path with NO forward in it:"
    note "  dd if=/dev/zero bs=1M count=64 | ssh $USER@berzelius1.nsc.liu.se 'cat >/dev/null'"
    note "  (dd prints the rate itself; 64 MB is ~10 s at 50 Mbit/s, ~2 min at 4)"
    note "much faster there => the ssh -L channel is the limit, not your uplink"
    printf "\n"
    note "stop it when done:  percorso-demo stop netcheck"
}

# ── power (staying above NSC's efficiency floor) ───────────────────────────────
# NSC terminates jobs whose moving-average power stays below 90 W (idle is 52 W;
# they have announced 100 W+). Exempt: the first hour of any job, NSC `interactive`
# jobs under 8 h, and jobs in a reservation. sacct cannot tell you your draw —
# energy accounting is off on this cluster (ConsumedEnergyRaw is 0 for every job) —
# so it has to be sampled live, which is what this does.
#
# It reports; it does not keep you above the line. If a demo idles, the honest fixes
# are a reservation (bjob 'percorso' profile sets one) or not holding the allocation
# while nobody is interacting.
cmd_power() {
    local dur=60 interval=5 watch=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --watch)    watch=1 ;;
            --interval) interval="${2:-5}"; shift ;;
            -*) die "unknown option '$1'" "power [seconds] [--interval N] [--watch]" ;;
            *)  dur="$1" ;;
        esac
        shift
    done
    command -v nvidia-smi >/dev/null 2>&1 || die "no nvidia-smi here" \
        "this reads the GPUs allocated to the job — run it on the compute node"

    [ -n "${SLURM_JOB_ID:-}" ] || note "not inside a SLURM job — this reading is not what NSC measures"

    local ngpu
    ngpu=$(nvidia-smi --query-gpu=power.draw --format=csv,noheader,nounits 2>/dev/null | grep -c .)
    [ "${ngpu:-0}" -gt 0 ] || die "nvidia-smi reported no GPUs" "is this job GPU-allocated?"

    if [ -n "$watch" ]; then
        # Detached: one line per sample into the service log, so you can leave it
        # running through a demo and read it afterwards.
        svc_start_container power "$(power_sample_cmd "$ngpu" "$interval" watch)" || return 1
        ok "power watch running (sampling every ${interval}s across $ngpu GPU(s))"
        note "read it:  percorso-demo logs power -f      stop:  percorso-demo stop power"
        return 0
    fi

    printf "percorso-demo power — %s, %s GPU(s), %ss at %ss intervals\n\n" \
           "$(hostname -s)" "$ngpu" "$dur" "$interval"
    note "NSC kills below ${POWER_FLOOR}W moving average; we warn below ${POWER_WARN}W"
    printf "\n"
    local out; out=$(timeout "$dur" bash -c "$(power_sample_cmd "$ngpu" "$interval" summary)")
    printf '%s\n' "$out"
    local mean; mean=$(printf '%s' "$out" | awk -F'mean=' 'NF>1{split($2,a," ");print a[1]}' | tail -1)
    mean="${mean%W}"
    [ -n "$mean" ] || { warn "no samples collected"; return 1; }
    if awk -v m="$mean" -v f="$POWER_FLOOR" 'BEGIN{exit !(m < f)}'; then
        warn "mean ${mean}W is BELOW NSC's ${POWER_FLOOR}W floor — this job is kill-eligible"
        power_advice; return 1
    elif awk -v m="$mean" -v w="$POWER_WARN" 'BEGIN{exit !(m < w)}'; then
        warn "mean ${mean}W is under our ${POWER_WARN}W margin — thin, and the floor is rising"
        power_advice; return 1
    fi
    ok "mean ${mean}W — comfortably above the floor"
}


case "${1:-}" in
    where|path) shift; cmd_where    "$@" ;;
    overlay)  shift; cmd_overlay  "$@" ;;
    run)      shift; cmd_run      "$@" ;;
    stream)   shift; cmd_stream   "$@" ;;
    snapshot) shift; cmd_snapshot "$@" ;;
    netcheck) shift; cmd_netcheck "$@" ;;
    doctor)   shift; cmd_doctor   "$@" ;;
    status)   shift; cmd_status   "$@" ;;
    power)    shift; cmd_power    "$@" ;;
    logs|log) shift; cmd_logs     "$@" ;;
    stop)     shift; cmd_stop     "$@" ;;
    pipeline) shift; cmd_pipeline "$@" ;;
    bag)      shift; cmd_bag      "$@" ;;
    *)
        cat <<USAGE
percorso-demo — run the live-demo pipeline: mock test (recorded bag) or real demo (robot)

  percorso-demo doctor                verify the DEMO code is what will run
  percorso-demo run bag [batch] [--loop] [--snapshot[=N]] [--cosmos reason2|nano]   mock test, one command
  percorso-demo run live [--bg] [--snapshot[=N]] [--cosmos reason2|nano]            real demo, one command

  percorso-demo status                what is running on this node, and is it healthy
  percorso-demo where                 print every path this tool uses
  percorso-demo overlay               one-time: build the demo ROS overlay
  percorso-demo power [sec] [--watch] GPU draw vs NSC's efficiency floor
  percorso-demo netcheck [--port N]   iperf3 server, to measure the robot's uplink
  percorso-demo logs <svc> [-f|N]     tail a background service's log
  percorso-demo stop <svc|all>        stop background services

'run' picks the params so you don't repeat them; 'stream'/'pipeline'/'bag'/
'snapshot' below are the pieces it calls, still here for manual control (a
mid-run batch swap, debugging, scripting):

  percorso-demo stream [--fg]                    raw TCP push receiver     (background)
  percorso-demo pipeline [label] [--bg]          perception + query bridge (foreground)
  percorso-demo bag [batch] [--loop] [--bg]      play the rosbag HERE      (foreground)
  percorso-demo snapshot [--interval N] [--out DIR]  periodic dsg.json/events.yaml capture (background)

Services that detach write a pid + log to $RUN_DIR
(per node — a stale pidfile from another node cannot be mistaken for a live one).
--fg watches a background-by-default service; --bg detaches a foreground one.
Snapshots land under $SNAPSHOT_DIR by default; visualize one with
scripts/export_rerun_output.py --output-dir <snapshot dir>.

quickest path to a mock test, one terminal:
  bjob                                # 'percorso', plus a second job: cosmos-reason2
                                       # (or cosmos3-nano-reasoner — pass --cosmos nano to 'run'
                                       # if cosmos-reason2 is stuck pending)
  percorso-demo doctor && percorso-demo run bag batch_7 --snapshot

quickest path to the real demo, one terminal + the robot/laptop:
  percorso-demo doctor && percorso-demo run live --snapshot
  (robot/laptop:  ssh-helper connect <node> stream, then
   tools/stream/sender/ros1_stream_sender.py --receiver-port 9001)

this file:  $SELF

env:  PERCORSO_BATCH  PERCORSO_BRIDGE_PORT  COSMOS_URL  PERCORSO_OVERLAY  PERCORSO_RUN_DIR
USAGE
        exit 1 ;;
esac
