#!/bin/bash
# bjob — Interactive SLURM job manager for Berzelius (NSC/LiU)

# ══════════════════════════════════════════════════════════════════════════════
# DEFAULT VALUES — starting point when creating a new profile (edit freely)
# ══════════════════════════════════════════════════════════════════════════════
D_ACCOUNT=""          # e.g. "berzelius-2024-1"  (blank = auto-detect)
D_PARTITION="berzelius"
D_GPUS="1"
D_TIME="06:00:00"
D_MEM="32G"
# ══════════════════════════════════════════════════════════════════════════════

set -euo pipefail

# ── Colors ────────────────────────────────────────────────────────────────────
R='\033[0;31m' G='\033[0;32m' Y='\033[1;33m'
B='\033[0;34m' C='\033[0;36m' BOLD='\033[1m' DIM='\033[2m' NC='\033[0m'

# ── Paths ─────────────────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
TOOLBOX_DIR="$(dirname "$SCRIPT_DIR")"
JOBS_DIR="$TOOLBOX_DIR/jobs"
PROJECT="${PROJECT:-/proj/rpl-soro/users/$USER}"

source "$SCRIPT_DIR/lib/power.sh"

mkdir -p "$JOBS_DIR"
leave_alt_screen() {
    tput cnorm 2>/dev/null || true
    if [[ "${BJOB_ALT_SCREEN:-0}" == "1" ]]; then
        printf '\033[H\033[2J\033[?1049l' 2>/dev/null || true
        BJOB_ALT_SCREEN=0
    fi
}
cleanup() {
    leave_alt_screen
    stty sane 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# ── Basic helpers ─────────────────────────────────────────────────────────────
header() {
    printf "${BOLD}${B}\n"
    printf "  ╔══════════════════════════════════════════╗\n"
    printf "  ║      Berzelius Job Manager  (bjob)       ║\n"
    printf "  ╚══════════════════════════════════════════╝\n"
    printf "${NC}\n"
}

get_jobs() {
    squeue -u "$USER" -h --format="%i|%T|%j|%P|%L|%R" 2>/dev/null || true
}

detect_accounts() {
    sacctmgr show associations user="$USER" format=account%40 -n -P 2>/dev/null \
        | cut -d'|' -f1 | sort -u | tr '\n' ' ' | xargs
}

prompt() {
    local label="$1" default="$2" varname="$3"
    local input
    read -rp "  $label [$default]: " input
    printf -v "$varname" '%s' "${input:-$default}"
}

term_cols() {
    local cols
    cols=$(tput cols 2>/dev/null || printf '80')
    [[ "$cols" =~ ^[0-9]+$ ]] || cols=80
    (( cols < 40 )) && cols=40
    printf '%s' "$cols"
}

trunc_pad() {
    local value="$1" width="$2"
    if (( width <= 0 )); then
        return 0
    fi
    if (( ${#value} > width )); then
        if (( width <= 1 )); then
            printf '%.*s' "$width" "$value"
        else
            printf '%s…' "${value:0:width-1}"
        fi
    else
        printf '%-*s' "$width" "$value"
    fi
}

rule_line() {
    local cols="$1" prefix="${2:-  }" width
    width=$(( cols - ${#prefix} - 1 ))
    (( width < 8 )) && width=8
    printf '%s' "$prefix"
    printf '%*s' "$width" '' | tr ' ' '-'
    printf '\n'
}

job_name_for_id() {
    local jobid="$1"
    squeue -j "$jobid" -h --format="%j" 2>/dev/null | awk 'NR==1 {print $1}'
}

usage() {
    cat <<EOF
Usage:
  bjob                         Open the interactive job manager
  bjob connect <jobid> [role]  Connect to a running allocation
  bjob cmds <jobid>            Print IDE-terminal commands for a job
  bjob gpu <jobid>             Show GPU power/utilization for a job
  bjob power <jobid> [secs] [interval]
                               Sample GPU power against NSC's kill floor
  bjob logs <jobid>            Print tmux/log file paths for a job

Some profiles define extra connect roles — run 'bjob cmds <jobid>' on a
running job to see them.
EOF
}

# ── Per-profile hooks ─────────────────────────────────────────────────────────
# Optional jobs/<name>/bjob_hooks.sh, sourced on demand — same pattern as
# setup.sh, but for extending bjob's own behavior instead of the shell
# environment. See docs/HANDOFF_bjob.md for the hook contract.
_HOOKS_LOADED_FOR=""
load_hooks() {
    local name="$1"
    [[ "$_HOOKS_LOADED_FOR" == "$name" ]] && return 0
    unset -f hook_pick_role hook_role_script hook_role_env \
             hook_role_help hook_launch hook_extra_log_globs 2>/dev/null
    local hooks="$JOBS_DIR/$name/bjob_hooks.sh"
    [[ -f "$hooks" ]] && source "$hooks"
    _HOOKS_LOADED_FOR="$name"
}

# ── Profile storage ───────────────────────────────────────────────────────────
list_profiles() {
    find "$JOBS_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort
}

load_profile() {
    local cfg="$JOBS_DIR/$1/config.sh"
    [[ -f "$cfg" ]] && source "$cfg" || true
}

save_profile() {
    local name="$1"
    mkdir -p "$JOBS_DIR/$name"
    cat > "$JOBS_DIR/$name/config.sh" <<EOF
D_ACCOUNT="$D_ACCOUNT"
D_PARTITION="$D_PARTITION"
D_GPUS="${D_GPUS:-1}"
D_TIME="$D_TIME"
D_MEM="$D_MEM"
D_JOBNAME="$name"
${D_RESERVATION:+D_RESERVATION=\"$D_RESERVATION\"}
EOF
}

# Plain-text one-liner summary for a profile (subshell — no side effects)
profile_line() {
    local name="$1" width="${2:-72}"
    (
        source "$JOBS_DIR/$name/config.sh" 2>/dev/null || true
        # Partition and account are omitted here on purpose: for this user they
        # are almost always the same single value across every profile, so
        # showing them per row is noise, not information.
        local size="${D_MEM:-?}"
        [[ "${D_PARTITION:-}" != "cpu" && "${D_PARTITION:-}" != "berzelius-cpu" ]] && size="${D_GPUS:-1}x${size}"
        local flags=""
        [[ -f "$JOBS_DIR/$name/setup.sh" ]] && flags="setup"
        [[ -n "${D_RESERVATION:-}" ]] && flags="${flags:+$flags }res:$D_RESERVATION"
        local line
        if (( width < 42 )); then
            line="${name} ${D_TIME:-?} ${size} ${flags}"
        else
            line=$(printf "%-22s %-9s %-7s %s"                 "$name" "${D_TIME:-?}" "$size" "$flags")
        fi
        trunc_pad "$line" "$width"
    )
}

# ── Shared result variable ────────────────────────────────────────────────────
_RESULT=""

# ── Global render state — main screen ────────────────────────────────────────
_SEL=0
_NJOBS=0
declare -a _JIDS=() _JSTATES=() _JNAMES=() _JPARTS=() _JTIMES=() _JREASONS=()

# ── Global render state — profile selector ────────────────────────────────────
_SP_SEL=0
_SP_N=0
declare -a _SP_PROFILES=() _SP_DISP=()

_draw() {
    local cols content_w i prefix state line hint
    cols=$(term_cols)
    content_w=$(( cols - 6 ))
    (( content_w < 20 )) && content_w=20

    for ((i = 0; i < _NJOBS; i++)); do
        if [[ $i -eq $_SEL ]]; then
            prefix="  ${G}❯${NC} ${BOLD}"
        else
            prefix="    ${DIM}"
        fi

        case "${_JSTATES[$i]}" in
            RUNNING) state="R" ;;
            PENDING) state="P" ;;
            *) state="${_JSTATES[$i]:0:1}" ;;
        esac

        if (( cols < 70 )); then
            line=$(printf '%s %s %s %s' \
                "${_JIDS[$i]}" "$state" "${_JNAMES[$i]}" "${_JTIMES[$i]}")
        else
            line=$(printf '%s %s %s %s %s' \
                "${_JIDS[$i]}" "$state" "${_JNAMES[$i]}" "${_JTIMES[$i]}" "${_JREASONS[$i]}")
        fi
        printf "%b%s${NC}\n" "$prefix" "$(trunc_pad "$line" "$content_w")"
    done

    printf "${DIM}"
    rule_line "$cols" "  "
    printf "${NC}"
    if [[ $_SEL -eq $_NJOBS ]]; then
        printf "  ${G}❯${NC} ${BOLD}${G}+ New job${NC}\n"
    else
        printf "    ${DIM}+ New job${NC}\n"
    fi
    printf "\n"

    if [[ $_SEL -lt $_NJOBS ]]; then
        if [[ "${_JSTATES[$_SEL]}" == "RUNNING" ]]; then
            if (( cols < 72 )); then
                hint='[c] conn [l] logs [g] gpu [k] kill [r] ref [q] quit'
            else
                hint='[c] connect  [p] cmds  [l] logs  [g] gpu  [k] cancel  up/down  [r] refresh  [q] quit'
            fi
        else
            if (( cols < 72 )); then
                hint='[k] kill  up/down  [r] ref  [q] quit'
            else
                hint='[k] cancel  up/down navigate  [r] refresh  [q] quit'
            fi
        fi
    else
        if (( cols < 72 )); then
            hint='[Enter] new  up/down  [r] ref  [q] quit'
        else
            hint='[Enter] new job  up/down navigate  [r] refresh  [q] quit'
        fi
    fi
    printf "  ${DIM}%s${NC}\n" "$(trunc_pad "$hint" "$content_w")"
}

# ── Profile selector draw (top-level — reads _SP_* globals) ──────────────────
_sp_draw() {
    local i cols item_w hint_w hint header
    cols=$(term_cols)
    item_w=$(( cols - 8 ))
    (( item_w < 24 )) && item_w=24
    hint_w=$(( cols - 4 ))
    (( hint_w < 20 )) && hint_w=20

    if (( item_w < 42 )); then
        header='NAME TIME GPUxMEM'
    else
        header=$(printf "%-22s %-9s %-7s %s" \
            "NAME" "TIME" "GPUxMEM" "FLAGS")
    fi
    printf "      ${BOLD}${C}%s${NC}\n" "$(trunc_pad "$header" "$item_w")"

    for ((i = 0; i < _SP_N; i++)); do
        if [[ $i -eq $_SP_SEL ]]; then
            printf "  ${BOLD}${G} ❯  ${NC}${BOLD}%s${NC}\n" "$(trunc_pad "${_SP_DISP[$i]}" "$item_w")"
        else
            printf "      ${DIM}%s${NC}\n" "$(trunc_pad "${_SP_DISP[$i]}" "$item_w")"
        fi
    done

    printf "${DIM}"
    rule_line "$cols" "      "
    printf "${NC}"
    if [[ $_SP_SEL -eq $_SP_N ]]; then
        printf "  ${BOLD}${G} ❯  ${NC}${BOLD}${G}+ Create profile${NC}\n"
    else
        printf "      ${DIM}+ Create profile${NC}\n"
    fi
    printf "\n"

    if [[ $_SP_SEL -lt $_SP_N ]]; then
        if (( cols < 72 )); then
            hint='up/down enter launch e path d del q back'
        else
            hint='up/down navigate  [Enter] launch  [d] delete  [e] setup.sh path  [q] back'
        fi
    else
        if (( cols < 72 )); then
            hint='up/down enter create q back'
        else
            hint='up/down navigate  [Enter] create  [q] back'
        fi
    fi
    printf "  ${DIM}%s${NC}\n" "$(trunc_pad "$hint" "$hint_w")"
}

# ── Arrow-key profile selector ────────────────────────────────────────────────
# Sets _RESULT; returns 0 on selection, 1 on back/quit.
select_profile() {
    _RESULT=""
    _SP_PROFILES=()
    mapfile -t _SP_PROFILES < <(list_profiles)
    _SP_N=${#_SP_PROFILES[@]}

    _SP_DISP=()
    local p cols item_w
    cols=$(term_cols)
    item_w=$(( cols - 8 ))
    (( item_w < 24 )) && item_w=24
    for p in "${_SP_PROFILES[@]}"; do
        _SP_DISP+=("$(profile_line "$p" "$item_w")")
    done
    _SP_SEL=0

    local nrows=$((_SP_N + 1))   # profiles + "new profile" row

    _paint_profiles() {
        printf '\033[H\033[2J'
        printf "\n${BOLD}${Y}  ── Job Profiles ──${NC}\n\n"
        _sp_draw
    }

    _paint_profiles
    tput civis 2>/dev/null

    while true; do
        local key="" seq=""
        if ! IFS= read -rsn1 key 2>/dev/null; then
            tput cnorm 2>/dev/null || true
            return 1
        fi

        case "$key" in
            $'\x1b')
                IFS= read -rsn2 -t 0.1 seq 2>/dev/null || true
                case "$seq" in
                    '[A') (( _SP_SEL > 0        )) && (( _SP_SEL-- )) || true ;;
                    '[B') (( _SP_SEL < nrows-1  )) && (( _SP_SEL++ )) || true ;;
                esac ;;
            '')  # Enter
                tput cnorm 2>/dev/null
                if [[ $_SP_SEL -eq $_SP_N ]]; then
                    _RESULT="__new__"
                else
                    _RESULT="${_SP_PROFILES[$_SP_SEL]}"
                fi
                return 0 ;;
            d|D)
                if [[ $_SP_SEL -lt $_SP_N ]]; then
                    tput cnorm 2>/dev/null
                    _RESULT="__delete__:${_SP_PROFILES[$_SP_SEL]}"; return 0
                fi ;;
            e|E)
                if [[ $_SP_SEL -lt $_SP_N ]]; then
                    tput cnorm 2>/dev/null
                    _RESULT="__edit__:${_SP_PROFILES[$_SP_SEL]}"; return 0
                fi ;;
            q|Q)
                tput cnorm 2>/dev/null
                return 1 ;;
        esac
        _paint_profiles
    done
}

# ── Profile wizard (create or edit) ──────────────────────────────────────────
wizard_profile() {
    _RESULT=""
    local edit="${1:-}"

    printf "\n${BOLD}${Y}  ── %s ──${NC}\n\n" \
        "${edit:+Edit profile: $edit}${edit:-New profile}"

    local pname="$edit"
    if [[ -z "$pname" ]]; then
        read -rp "  Profile name: " pname
        pname="${pname// /_}"
        if [[ -z "$pname" ]]; then printf "${R}  Cancelled.${NC}\n"; return; fi
    fi

    [[ -n "$edit" ]] && load_profile "$edit"

    local accounts first_acc
    accounts=$(detect_accounts)
    first_acc=$(awk '{print $1}' <<< "$accounts")
    [[ -z "$D_ACCOUNT" ]] && \
        printf "  ${C}Available accounts:${NC} %s\n" "${accounts:-<none detected>}"
    while true; do
        prompt "Account" "${D_ACCOUNT:-${first_acc}}" D_ACCOUNT
        [[ -n "$D_ACCOUNT" ]] && break
        printf "  ${R}Account cannot be empty.${NC}\n"
    done

    printf "\n  ${C}Partitions:${NC}\n"
    printf "    berzelius      — GPU nodes (NVIDIA A100)\n"
    printf "    berzelius-cpu  — CPU-only nodes\n"
    prompt "Partition" "$D_PARTITION" D_PARTITION

    local gpu_flag=""
    if [[ "$D_PARTITION" != "cpu" && "$D_PARTITION" != "berzelius-cpu" ]]; then
        prompt "Number of GPUs" "${D_GPUS:-1}" D_GPUS
        gpu_flag="--gpus=$D_GPUS"
    fi
    prompt "Time limit (HH:MM:SS)" "$D_TIME" D_TIME
    prompt "Memory"                "$D_MEM"  D_MEM

    save_profile "$pname"
    printf "${G}  Profile '%s' saved → %s/${NC}\n" "$pname" "$JOBS_DIR/$pname"

    local setup="$JOBS_DIR/$pname/setup.sh"
    if [[ ! -f "$setup" ]]; then
        printf "\n"
        read -rp "  Create a setup.sh? (sourced automatically after allocation starts) [y/N]: " ans
        if [[ "$ans" =~ ^[Yy]$ ]]; then
            cat > "$setup" <<TMPL
#!/bin/bash
# setup.sh for profile: $pname
# Sourced automatically after your SLURM allocation starts.

export PROJECT=/proj/rpl-soro/users/\$USER

# ── Apptainer ──────────────────────────────────────────────────────────────
# apptainer shell --nv \\
#     -B \$PROJECT/ros2_ws:/ros2_ws \\
#     \$PROJECT/containers/$pname.sif

# ── Conda ──────────────────────────────────────────────────────────────────
# conda activate myenv
TMPL
            chmod +x "$setup"
            printf "${G}  Created %s${NC}\n" "$setup"
            printf "${C}  Edit it any time, or press [e] in the profile list.${NC}\n"
        fi
    fi

    _RESULT="$pname"
}

# ── Launch a profile ──────────────────────────────────────────────────────────
launch_profile() {
    local name="$1"
    load_profile "$name"

    # Auto-detect account if not set in profile
    if [[ -z "${D_ACCOUNT:-}" ]]; then
        local detected; detected=$(detect_accounts)
        D_ACCOUNT=$(awk '{print $1}' <<< "$detected")
    fi
    if [[ -z "${D_ACCOUNT:-}" ]]; then
        printf "\n${R}  Could not detect a SLURM account for user '%s'.${NC}\n" "$USER"
        printf "\n  ${DIM}Press any key to return...${NC}"
        IFS= read -rsn1 2>/dev/null || true
        return 1
    fi

    local gpu_flag=""
    [[ "${D_PARTITION:-}" != "cpu" && "${D_PARTITION:-}" != "berzelius-cpu" ]] && gpu_flag="--gpus=${D_GPUS:-1}"

    printf "\n${BOLD}${Y}  Launching: %s${NC}\n" "$name"
    if [[ -n "$gpu_flag" ]]; then
        printf "  ${DIM}%s · %s GPU · %s · %s · account=%s%s${NC}\n" \
            "$D_PARTITION" "$D_GPUS" "$D_TIME" "$D_MEM" "$D_ACCOUNT" \
            "${D_RESERVATION:+ · reservation=$D_RESERVATION}"
    else
        printf "  ${DIM}%s · %s · %s · account=%s${NC}\n" \
            "$D_PARTITION" "$D_TIME" "$D_MEM" "$D_ACCOUNT"
    fi

    local -a srun_args=(
        --account="$D_ACCOUNT" --partition="$D_PARTITION"
        --time="$D_TIME" --mem="$D_MEM" --job-name="$name"
    )
    [[ -n "$gpu_flag" ]] && srun_args+=("$gpu_flag")
    # NSC kills jobs whose moving-average power stays under 90 W (rising to 100 W+),
    # exempting only: the first hour, NSC `interactive` jobs under 8 h, and jobs in a
    # reservation. A profile that legitimately idles between bursts — a live demo
    # waiting on a person — needs one of those, so a reservation is a profile field.
    [[ -n "${D_RESERVATION:-}" ]] && srun_args+=(--reservation="$D_RESERVATION")

    printf "\n${Y}  Requesting allocation — waiting for a free node...${NC}\n"
    printf "${C}  (Ctrl-C to cancel)${NC}\n\n"

    local setup="$JOBS_DIR/$name/setup.sh"
    local exit_code=0
    if [[ -f "$setup" ]]; then
        printf "${C}  setup.sh found — will be sourced after login.${NC}\n\n"
        local rc; rc=$(mktemp "$HOME/.bjob_rc_XXXXXX")
        printf 'cd "%s"\n[[ -f ~/.bashrc ]] && source ~/.bashrc\nsource "%s"\n' "$PROJECT" "$setup" > "$rc"
        srun "${srun_args[@]}" --pty bash --rcfile "$rc" || exit_code=$?
        rm -f "$rc"
    else
        srun "${srun_args[@]}" --pty bash || exit_code=$?
    fi

    [[ -n "${hook_pid:-}" ]] && kill "$hook_pid" 2>/dev/null && wait "$hook_pid" 2>/dev/null

    if [[ $exit_code -ne 0 ]]; then
        printf "\n${R}  srun failed (exit %d) — check account/partition/resources.${NC}\n" "$exit_code"
        printf "  ${DIM}Press any key to return...${NC}"
        IFS= read -rsn1 2>/dev/null || true
    fi
}

# ── Connect to a running job ──────────────────────────────────────────────────
connect_job() {
    local jobid="$1" jobname="${2:-}" role="${3:-}"
    [[ -z "$jobname" ]] && jobname="$(job_name_for_id "$jobid")"

    if [[ -z "$jobname" ]]; then
        printf "\n${R}  Could not find running job %s.${NC}\n" "$jobid"
        return 1
    fi

    printf "\n${G}  Connecting to job %s (%s)...${NC}\n" "$jobid" "$jobname"

    load_hooks "$jobname"
    if [[ -z "$role" ]] && declare -f hook_pick_role >/dev/null 2>&1; then
        role="$(hook_pick_role)" || return 1
    fi

    if [[ "$role" == "gpu" ]]; then
        gpu_status "$jobid"
        return $?
    fi
    if [[ "$role" == "logs" || "$role" == "log" ]]; then
        log_paths "$jobid" "$jobname"
        return $?
    fi

    local role_script=""
    local -a role_env=()
    if [[ -n "$role" ]]; then
        case "$role" in
            shell) role_script="" ;;
            *)
                if declare -f hook_role_script >/dev/null 2>&1; then
                    role_script="$(hook_role_script "$role")"
                fi
                if [[ -z "$role_script" ]]; then
                    printf "${R}  Unknown role '%s' for profile '%s'. Try: shell, gpu, logs%s.${NC}\n" \
                        "$role" "$jobname" "$(declare -f hook_pick_role >/dev/null 2>&1 && printf ' (see bjob cmds %s)' "$jobid")"
                    return 1
                fi
                role_script="$JOBS_DIR/$jobname/$role_script" ;;
        esac
        if [[ -n "$role_script" && ! -f "$role_script" ]]; then
            printf "${R}  Profile '%s' does not define role '%s'.${NC}\n" "$jobname" "$role"
            return 1
        fi
    fi

    local role_env_out=""
    if [[ -n "$role_script" ]] && declare -f hook_role_env >/dev/null 2>&1; then
        role_env_out="$(hook_role_env "$role")" || return 1
    fi
    [[ -n "$role_env_out" ]] && mapfile -t role_env <<< "$role_env_out"

    # --overlap is the important bit: it allows multiple IDE terminals to create
    # separate job steps inside the same allocation instead of waiting forever.
    if [[ -n "$role_script" ]]; then
        printf "${C}  Role: %s${NC}\n" "$role"
        if [[ ${#role_env[@]} -gt 0 ]]; then
            local _bstart="" _bend="" _e
            for _e in "${role_env[@]}"; do
                case "$_e" in
                    DAAAM_AUTO_BATCH_START=*) _bstart="${_e#DAAAM_AUTO_BATCH_START=}" ;;
                    DAAAM_AUTO_BATCH_END=*)   _bend="${_e#DAAAM_AUTO_BATCH_END=}" ;;
                esac
            done
            [[ -n "$_bstart" ]] && printf "${C}  Batch range: batch_%s..batch_%s${NC}\n" "$_bstart" "$_bend"
            printf "\n"
            srun --overlap --pty --jobid "$jobid" env "${role_env[@]}" bash "$role_script"
        else
            printf "\n"
            srun --overlap --pty --jobid "$jobid" bash "$role_script"
        fi
        return $?
    fi

    local connect="$JOBS_DIR/$jobname/connect.sh"
    local setup="$JOBS_DIR/$jobname/setup.sh"
    if [[ -f "$connect" ]]; then
        printf "${C}  Found connect.sh for '%s' — will be sourced.${NC}\n\n" "$jobname"
        local rc; rc=$(mktemp "$HOME/.bjob_rc_XXXXXX")
        printf 'cd "%s"\n[[ -f ~/.bashrc ]] && source ~/.bashrc\nsource "%s"\n' "$PROJECT" "$connect" > "$rc"
        srun --overlap --pty --jobid "$jobid" bash --rcfile "$rc"
        rm -f "$rc"
    elif [[ -f "$setup" ]] && ! declare -f hook_pick_role >/dev/null 2>&1; then
        printf "${C}  Found setup.sh for '%s' — will be sourced.${NC}\n\n" "$jobname"
        local rc; rc=$(mktemp "$HOME/.bjob_rc_XXXXXX")
        printf 'cd "%s"\n[[ -f ~/.bashrc ]] && source ~/.bashrc\nsource "%s"\n' "$PROJECT" "$setup" > "$rc"
        srun --overlap --pty --jobid "$jobid" bash --rcfile "$rc"
        rm -f "$rc"
    else
        srun --overlap --pty --jobid "$jobid" /bin/bash
    fi
}

print_ide_commands() {
    local jobid="$1" jobname="${2:-}"
    [[ -z "$jobname" ]] && jobname="$(job_name_for_id "$jobid")"
    if [[ -z "$jobname" ]]; then
        printf "\n${R}  Could not find running job %s.${NC}\n" "$jobid"
        return 1
    fi

    load_hooks "$jobname"
    printf "\n${BOLD}${Y}  IDE terminal commands for job %s (%s)${NC}\n\n" "$jobid" "$jobname"
    if declare -f hook_pick_role >/dev/null 2>&1; then
        printf "  bjob connect %s\n" "$jobid"
        printf "  bjob logs %s\n" "$jobid"
        if declare -f hook_role_help >/dev/null 2>&1; then
            hook_role_help
        else
            printf "\n  ${DIM}This profile offers multiple roles — run 'bjob connect %s' and choose.${NC}\n" "$jobid"
        fi
    else
        printf "  bjob connect %s\n" "$jobid"
        printf "  bjob gpu %s\n" "$jobid"
        printf "  bjob logs %s\n" "$jobid"
    fi
}

gpu_status() {
    local jobid="$1"
    printf "\n${BOLD}${Y}  GPU status for job %s${NC}\n\n" "$jobid"
    srun --overlap --jobid "$jobid" nvidia-smi \
        --query-gpu=index,name,pstate,power.draw,power.limit,utilization.gpu,memory.used,memory.total \
        --format=csv 2>/dev/null || \
    srun --overlap --jobid "$jobid" nvidia-smi
}

# One-shot power sample against NSC's kill-floor, for any running job — no
# need to be inside that job's shell. Uses the same sampler as
# 'percorso-demo power' (bin/lib/power.sh), just reached via --overlap
# instead of running on the node directly.
power_status() {
    local jobid="$1" dur="${2:-30}" interval="${3:-5}"
    printf "\n${BOLD}${Y}  Power draw for job %s — %ss at %ss intervals${NC}\n\n" "$jobid" "$dur" "$interval"

    local ngpu
    ngpu=$(srun --overlap --jobid "$jobid" nvidia-smi --query-gpu=power.draw \
             --format=csv,noheader,nounits 2>/dev/null | grep -c . || true)
    if [[ "${ngpu:-0}" -eq 0 ]]; then
        printf "${R}  Could not read GPUs for job %s — is it GPU-allocated?${NC}\n" "$jobid"
        return 1
    fi

    printf "${DIM}        NSC kills below ${POWER_FLOOR}W moving average; we warn below ${POWER_WARN}W${NC}\n\n"
    local out
    out=$(srun --overlap --jobid "$jobid" timeout "$dur" \
            bash -c "$(power_sample_cmd "$ngpu" "$interval" summary)" || true)
    printf '%s\n' "$out"

    local mean
    mean=$(printf '%s' "$out" | awk -F'mean=' 'NF>1{split($2,a," ");print a[1]}' | tail -1)
    mean="${mean%W}"
    if [[ -z "$mean" ]]; then
        printf "${Y}  no samples collected${NC}\n"
        return 1
    fi
    if awk -v m="$mean" -v f="$POWER_FLOOR" 'BEGIN{exit !(m < f)}'; then
        printf "${R}  mean %sW is BELOW NSC's %sW floor — job %s is kill-eligible${NC}\n" "$mean" "$POWER_FLOOR" "$jobid"
        power_advice; return 1
    elif awk -v m="$mean" -v w="$POWER_WARN" 'BEGIN{exit !(m < w)}'; then
        printf "${Y}  mean %sW is under our %sW margin — thin, and the floor is rising${NC}\n" "$mean" "$POWER_WARN"
        power_advice; return 1
    fi
    printf "${G}  mean %sW — comfortably above the floor${NC}\n" "$mean"
}

log_paths() {
    local jobid="$1" jobname="${2:-}"
    local project="${PROJECT:-/proj/rpl-soro/users/$USER}"
    local log_dir="$project/.cache/bjob-tmux"
    local found=0 file

    [[ -z "$jobname" ]] && jobname="$(job_name_for_id "$jobid" || true)"
    [[ -n "$jobname" ]] && load_hooks "$jobname"
    printf "\n${BOLD}${Y}  Log paths for job %s%s${NC}\n\n" "$jobid" "${jobname:+ ($jobname)}"

    if [[ -d "$log_dir" ]]; then
        for file in "$log_dir"/daaam-"$jobid"-*.log "$log_dir"/daaam-"$jobid".log; do
            [[ -e "$file" ]] || continue
            printf "  %s\n" "$file"
            found=1
        done
    fi

    if [[ -d "$project/.cache/daaam-cosmos-auto" ]]; then
        for file in "$project/.cache/daaam-cosmos-auto"/"$jobid"-* "$project/.cache/daaam-cosmos-auto"/"$jobid"; do
            [[ -d "$file" ]] || continue
            printf "  %s/logs\n" "$file"
            found=1
        done
    fi

    if declare -f hook_extra_log_globs >/dev/null 2>&1; then
        while IFS= read -r extra; do
            [[ -n "$extra" ]] || continue
            printf "  %s\n" "$extra"
            found=1
        done < <(hook_extra_log_globs)
    elif [[ -f "$project/.cache/cosmos-reason2-vllm.log" ]]; then
        printf "  %s\n" "$project/.cache/cosmos-reason2-vllm.log"
        found=1
    fi

    # afk jobs (cosmos-server / daaam-worker) register their state dir
    local reg_file="$project/.bjob/afk-session.$jobid"
    if [[ -f "$reg_file" ]]; then
        local sdir; sdir=$(cat "$reg_file")
        printf "  %s/logs\n" "$sdir"
        printf "    tail -f %s/logs/auto_launch_terminal.log\n" "$sdir"
        printf "    tail -f %s/logs/cosmos-reason2-vllm.log\n" "$sdir"
        found=1
    fi

    if [[ $found -eq 0 ]]; then
        printf "  No bjob tmux log files found yet under %s\n" "$log_dir"
        printf "  DAAAM logs appear after launching or connecting a tmux-backed daaam session.\n"
    fi
}

# ── Cancel a job ──────────────────────────────────────────────────────────────
cancel_job() {
    local jobid="$1" name="$2"
    read -rp "  Really cancel job $jobid ($name)? [y/N]: " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        scancel "$jobid"
        printf "${R}  Job %s cancelled.${NC}\n" "$jobid"
    else
        printf "  Skipped.\n"
    fi
}

# ── New-job handler: profile selector → action loop ───────────────────────────
handle_new_job() {
    while true; do
        if ! select_profile; then return; fi   # q/back → return to main screen

        case "$_RESULT" in
            __new__)
                wizard_profile
                # loop back to show updated selector
                ;;
            __delete__:*)
                local target="${_RESULT#__delete__:}"
                read -rp "  Delete profile '$target'? [y/N]: " yn
                if [[ "$yn" =~ ^[Yy]$ ]]; then
                    rm -rf "${JOBS_DIR:?}/$target"
                    printf "${R}  Profile '%s' deleted.${NC}\n" "$target"
                    printf "\n  ${DIM}Press any key to continue...${NC}"
                    IFS= read -rsn1 2>/dev/null || true
                fi ;;
            __edit__:*)
                local pname="${_RESULT#__edit__:}"
                local setup="$JOBS_DIR/$pname/setup.sh"
                if [[ ! -f "$setup" ]]; then
                    read -rp "  No setup.sh for '$pname'. Create one? [Y/n]: " yn
                    [[ ! "$yn" =~ ^[Nn]$ ]] && wizard_profile "$pname"
                else
                    printf "\n${C}  %s${NC}\n" "$setup"
                    printf "\n  ${DIM}Ctrl/Cmd-click the path above to open it, or press any key to continue...${NC}"
                    IFS= read -rsn1 2>/dev/null || true
                fi ;;
            *)
                load_hooks "$_RESULT"
                if declare -f hook_launch >/dev/null 2>&1; then
                    hook_launch "$_RESULT"
                else
                    launch_profile "$_RESULT"
                fi
                return ;;
        esac
        tput civis 2>/dev/null   # re-hide cursor after any interactive action
    done
}

# ── Main TUI screen ───────────────────────────────────────────────────────────
# Renders the job list as an arrow-key navigable table.
# Returns 1 to quit, 0 to refresh (after any action).
_main_screen() {
    printf '\033[H\033[2J'   # cursor home + erase display (within alternate screen)
    header

    # Fetch and populate global render state
    local raw_jobs
    raw_jobs=$(get_jobs)

    _JIDS=(); _JSTATES=(); _JNAMES=(); _JPARTS=(); _JTIMES=(); _JREASONS=()
    if [[ -n "$raw_jobs" ]]; then
        while IFS='|' read -r jid state jname jpart jtime jreason; do
            _JIDS+=("$jid"); _JSTATES+=("$state"); _JNAMES+=("$jname")
            _JPARTS+=("$jpart"); _JTIMES+=("$jtime"); _JREASONS+=("$jreason")
        done <<< "$raw_jobs"
    fi
    _NJOBS=${#_JIDS[@]}
    _SEL=0

    local nrows=$((_NJOBS + 1))

    # Static column header
    local cols header_w header
    cols=$(term_cols)
    header_w=$(( cols - 6 ))
    (( header_w < 20 )) && header_w=20
    if (( cols < 70 )); then
        header='JOBID S NAME TIME'
    else
        header='JOBID S NAME TIME NODE/REASON'
    fi

    _paint_jobs() {
        printf '\033[H\033[2J'
        header
        printf "${BOLD}${C}    %s${NC}\n" "$(trunc_pad "$header" "$header_w")"
        rule_line "$cols" "  "
        _draw
    }

    _paint_jobs
    tput civis 2>/dev/null   # hide cursor before entering key loop

    while true; do
        local key="" seq=""
        if ! IFS= read -rsn1 key 2>/dev/null; then
            tput cnorm 2>/dev/null || true
            return 1
        fi

        case "$key" in
            $'\x1b')
                IFS= read -rsn2 -t 0.1 seq 2>/dev/null || true
                case "$seq" in
                    '[A') (( _SEL > 0       )) && (( _SEL-- )) || true ;;
                    '[B') (( _SEL < nrows-1 )) && (( _SEL++ )) || true ;;
                esac ;;

            '')   # Enter — only acts on "new job" row
                if [[ $_SEL -eq $_NJOBS ]]; then
                    tput cnorm 2>/dev/null
                    handle_new_job; return 0
                fi ;;

            c|C)  # Connect (RUNNING only)
                if [[ $_SEL -lt $_NJOBS && "${_JSTATES[$_SEL]}" == "RUNNING" ]]; then
                    leave_alt_screen
                    connect_job "${_JIDS[$_SEL]}" "${_JNAMES[$_SEL]}"
                    return 1
                fi ;;

            p|P)  # Print IDE terminal commands
                if [[ $_SEL -lt $_NJOBS && "${_JSTATES[$_SEL]}" == "RUNNING" ]]; then
                    leave_alt_screen
                    print_ide_commands "${_JIDS[$_SEL]}" "${_JNAMES[$_SEL]}"
                    return 1
                fi ;;

            g|G)  # GPU status
                if [[ $_SEL -lt $_NJOBS && "${_JSTATES[$_SEL]}" == "RUNNING" ]]; then
                    leave_alt_screen
                    gpu_status "${_JIDS[$_SEL]}"
                    return 1
                fi ;;

            l|L)  # Log paths
                if [[ $_SEL -lt $_NJOBS && "${_JSTATES[$_SEL]}" == "RUNNING" ]]; then
                    leave_alt_screen
                    log_paths "${_JIDS[$_SEL]}" "${_JNAMES[$_SEL]}"
                    return 1
                fi ;;

            k|K)  # Cancel any job
                if [[ $_SEL -lt $_NJOBS ]]; then
                    tput cnorm 2>/dev/null
                    cancel_job "${_JIDS[$_SEL]}" "${_JNAMES[$_SEL]}"
                    printf "\n  ${DIM}Press any key to refresh...${NC}"
                    IFS= read -rsn1 2>/dev/null || true
                    return 0
                fi ;;

            r|R)  # Manual refresh
                tput cnorm 2>/dev/null
                return 0 ;;

            q|Q)
                tput cnorm 2>/dev/null
                return 1 ;;
        esac

        _paint_jobs
    done
}

# ── Main ──────────────────────────────────────────────────────────────────────
main() {
    if [[ ! -t 0 || ! -t 1 ]]; then
        printf "bjob interactive UI requires a TTY. Use commands like 'bjob connect <jobid>', 'bjob logs <jobid>', or run bjob from an interactive terminal.\n" >&2
        return 2
    fi

    BJOB_ALT_SCREEN=1
    printf '\033[?1049h'   # enter alternate screen buffer (blank slate, restored on exit)
    tput civis 2>/dev/null # hide cursor once for the whole TUI session
    while true; do
        _main_screen || break
    done
    leave_alt_screen
}

case "${1:-}" in
    connect)
        [[ $# -ge 2 ]] || { usage; exit 2; }
        connect_job "$2" "" "${3:-}" ;;
    cmds|commands)
        [[ $# -ge 2 ]] || { usage; exit 2; }
        print_ide_commands "$2" ;;
    gpu)
        [[ $# -ge 2 ]] || { usage; exit 2; }
        gpu_status "$2" ;;
    power)
        [[ $# -ge 2 ]] || { usage; exit 2; }
        power_status "$2" "${3:-30}" "${4:-5}" ;;
    logs|log)
        [[ $# -ge 2 ]] || { usage; exit 2; }
        log_paths "$2" ;;
    -h|--help|help)
        usage ;;
    "")
        main ;;
    *)
        usage
        exit 2 ;;
esac
